+let bridgeMenuLoadError070 = '';
+function requestBridgeMenuLoad070() {
+  if (bridgeMenuLoadRequested070 || typeof document === 'undefined') return;
+  bridgeMenuLoadRequested070 = true;
+  try {
+    const script = document.createElement('script');
+    script.id = 'ecbridge-menu-loader-070';
+    script.src = new URL('./effectcraft-bridge-ipad.070.js', location.href).href;
+    script.onerror = () => { bridgeMenuLoadError070 = 'ZIP commands could not load. Close and reopen EffectCraft.'; };
