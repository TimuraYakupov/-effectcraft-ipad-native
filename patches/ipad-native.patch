--- /dev/null
+++ b/apps/effectcraft-ios/src/user_fonts.rs
@@ -0,0 +1,129 @@
+//! Persistent, validated user font files shared with the native renderer.
+use effectcraft_engine::text::fonts;
+use std::hash::{Hash, Hasher};
+use std::io::Read;
+use std::path::{Path, PathBuf};
+const MAX_FILE: u64 = 32 << 20;
+const MAX_TOTAL: u64 = 128 << 20;
+
+fn bytes(path: &Path) -> Result<Vec<u8>, String> {
+    let meta = std::fs::symlink_metadata(path).map_err(|e| e.to_string())?;
+    if !meta.is_file() || meta.len() > MAX_FILE {
+        return Err("Choose a regular font file up to 32 MiB".into());
+    }
+    let mut data = Vec::new();
+    std::fs::File::open(path).map_err(|e| e.to_string())?.take(MAX_FILE + 1).read_to_end(&mut data).map_err(|e| e.to_string())?;
+    if data.len() as u64 > MAX_FILE {
+        return Err("Font exceeds 32 MiB".into());
+    }
+    if data.get(..4) == Some(b"ttcf") {
+        let count = u32::from_be_bytes(data.get(8..12).ok_or("Truncated font collection")?.try_into().map_err(|_| "Invalid font collection")?);
+        if count == 0 || count > 64 {
+            return Err("Font collections are limited to 64 faces".into());
+        }
+    }
+    Ok(data)
+}
+fn stored(root: &Path) -> Result<Vec<PathBuf>, String> {
+    std::fs::create_dir_all(root).map_err(|e| e.to_string())?;
+    let mut files = Vec::new();
+    let mut total = 0_u64;
+    for entry in std::fs::read_dir(root).map_err(|e| e.to_string())?.take(129) {
+        let entry = entry.map_err(|e| e.to_string())?;
+        let meta = std::fs::symlink_metadata(entry.path()).map_err(|e| e.to_string())?;
+        if !meta.is_file() {
+            continue;
+        }
+        total = total.saturating_add(meta.len());
+        files.push(entry.path());
+    }
+    if files.len() > 128 || total > MAX_TOTAL {
+        return Err("User fonts are limited to 128 files / 128 MiB".into());
+    }
+    files.sort();
+    Ok(files)
+}
+pub fn restore(root: &Path) -> Vec<String> {
+    let files = match stored(root) {
+        Ok(files) => files,
+        Err(e) => return vec![e],
+    };
+    files.into_iter().filter_map(|path| bytes(&path).and_then(fonts::add_font_data_checked).err().map(|e| format!("{}: {e}", path.display()))).collect()
+}
+pub fn import(root: &Path, paths: &[PathBuf]) -> Result<String, String> {
+    if paths.is_empty() || paths.len() > 32 {
+        return Err("Choose 1–32 TTF/OTF font files".into());
+    }
+    let mut files = stored(root)?;
+    let mut total: u64 = files.iter().filter_map(|p| std::fs::metadata(p).ok().map(|m| m.len())).sum();
+    let (mut added, mut duplicate) = (0, 0);
+    let mut errors = Vec::new();
+    for path in paths {
+        let result = (|| {
+            let ext = path.extension().and_then(|s| s.to_str()).unwrap_or("").to_ascii_lowercase();
+            if !matches!(ext.as_str(), "ttf" | "otf" | "ttc" | "otc") {
+                return Err("Choose TTF, OTF, TTC or OTC".to_string());
+            }
+            let data = bytes(path)?;
+            let mut hash = std::collections::hash_map::DefaultHasher::new();
+            data.hash(&mut hash);
+            let target = root.join(format!("font_{:016x}_{}.{ext}", hash.finish(), data.len()));
+            if target.exists() {
+                if bytes(&target)? == data {
+                    duplicate += 1;
+                    return Ok(());
+                }
+                return Err("Font storage name conflict".into());
+            }
+            if files.len() >= 128 || total.saturating_add(data.len() as u64) > MAX_TOTAL {
+                return Err("User fonts are limited to 128 files / 128 MiB".into());
+            }
+            // The parser validates usable name/glyph tables before persistence.
+            fonts::add_font_data_checked(data.clone())?;
+            use effectcraft_engine::Services;
+            effectcraft_engine::FsServices.write_file(&target.to_string_lossy(), &data).map_err(|e| e.to_string())?;
+            total += data.len() as u64;
+            files.push(target);
+            added += 1;
+            Ok(())
+        })();
+        if let Err(e) = result {
+            errors.push(format!("{}: {e}", path.file_name().unwrap_or_default().to_string_lossy()));
+        }
+    }
+    Ok(format!("Fonts added: {added}; already installed: {duplicate}. Select them in Character. {}", errors.join("; ")))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn imported_font_is_registered_persistent_and_deduplicated() {
+        let root = std::env::temp_dir().join(format!("ec-font-persist-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let input = root.join("Source.ttf");
+        let mut data = fonts::INTER_REGULAR.to_vec();
+        for (from, to) in [(b"Inter".as_slice(), b"Probe".as_slice()), (b"\0I\0n\0t\0e\0r".as_slice(), b"\0P\0r\0o\0b\0e".as_slice())] {
+            for at in 0..=data.len().saturating_sub(from.len()) {
+                if let Some(bytes) = data.get_mut(at..at + from.len()) {
+                    if bytes == from {
+                        bytes.copy_from_slice(to);
+                    }
+                }
+            }
+        }
+        std::fs::write(&input, data).unwrap();
+        let installed = root.join("Installed");
+        assert!(import(&installed, &[input.clone()]).unwrap().contains("Fonts added: 1"));
+        assert!(fonts::all_faces().iter().any(|f| f.info.family.contains("Probe")));
+        assert_eq!(stored(&installed).unwrap().len(), 1);
+        assert!(import(&installed, &[input]).unwrap().contains("already installed: 1"));
+        assert!(restore(&installed).is_empty());
+        let bad = root.join("Bad.otf");
+        std::fs::write(&bad, b"not a font").unwrap();
+        assert!(import(&installed, &[bad]).unwrap().contains("Invalid"));
+        assert_eq!(stored(&installed).unwrap().len(), 1);
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
