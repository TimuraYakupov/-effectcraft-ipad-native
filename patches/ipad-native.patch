+//! First native iPad smoke prototype. UIKit lifecycle is owned by winit;
+//! eframe and the compositor share a Metal device; the Rust editor runs without a WebView.
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic, clippy::unimplemented, clippy::todo, clippy::unreachable)]
+
+use effectcraft_ui_egui::EffectcraftApp;
+use serde_json::json;
+#[cfg(target_os = "ios")]
+#[path = "../../effectcraft/src/audio_out.rs"]
+mod audio_out;
+mod settings;
+mod lifecycle;
+mod render_files;
+#[cfg(test)]
+mod media_drag_tests;
+mod bridge;
+mod diagnostics;
+mod files;
+mod journal;
+mod key_codes;
+mod keyboard;
+mod native_documents;
+mod project_zip;
+mod store_zip;
+mod user_fonts;
+
+fn main() -> eframe::Result {
+    effectcraft_engine::logging::install();
+    effectcraft_engine::logging::install_panic_hook();
+    let directory = journal::log_directory();
+    let startup_error = effectcraft_engine::logging::attach_session_log(&directory).err();
+    log::info!(target: "effectcraft_diagnostics", "build=16 startup workers=1 preview_mib=2048 disk_gib=1 hardware_keyboard=responder_chain");
+    let mut graphics = eframe::WgpuConfiguration::default();
+    if let eframe::egui_wgpu::WgpuSetup::CreateNew(setup) = &mut graphics.wgpu_setup {
+        setup.instance_descriptor.backends = eframe::wgpu::Backends::METAL;
+        setup.instance_descriptor.flags = setup.instance_descriptor.flags.difference(eframe::wgpu::InstanceFlags::VALIDATION_INDIRECT_CALL);
+        setup.device_descriptor = std::sync::Arc::new(|adapter| {
+            let mut limits = adapter.limits();
+            limits.max_texture_dimension_2d = limits.max_texture_dimension_2d.min(16384);
+            eframe::wgpu::DeviceDescriptor { label: Some("EffectCraft iPad Metal"), required_limits: limits, ..Default::default() }
+        });
+    }
+    eframe::run_native(
+        "EffectCraft",
+        eframe::NativeOptions {
+            viewport: eframe::egui::ViewportBuilder::default().with_title("EffectCraft").with_fullscreen(true),
+            renderer: eframe::Renderer::Wgpu,
+            // UIKit's event loop must be entered once, rather than run-on-demand.
+            run_and_return: false,
+            wgpu_options: graphics,
+            ..Default::default()
+        },
+        Box::new(|cc| {
+            #[cfg(target_os = "ios")]
+            if let Some(window) = cc.winit_window() {
+                use winit::platform::ios::WindowExtIOS;
+                window.set_prefers_status_bar_hidden(true);
+                window.set_prefers_home_indicator_hidden(true);
+            }
+            if let Some(rs) = &cc.wgpu_render_state {
+                log::info!("native iPad adapter: {:?}", rs.adapter.get_info());
+            }
+            for error in user_fonts::restore(&bridge::documents().join("Fonts")) {
+                log::warn!("User font restore: {error}");
+            }
+            let mut session = effectcraft_host::session();
+            settings::configure(&mut session, &bridge::documents());
+            let recovery = session.begin_recovery();
+            // This first build is for graphics/touch verification only. Use the bundled,
+            // openly licensed synthetic project; no private files are embedded.
+            let status = match session.execute("file.openDemoProject", json!({})) {
+                Ok(_) => format!("EffectCraft · build 16. RAM: {} MiB.", session.prefs.memory.preview_cache_mb),
+                Err(error) => format!("Could not open the demo: {error}"),
+            };
+            let mut app = EffectcraftApp::new(session);
+            if let Some(recovery) = recovery { app.offer_recovery(recovery); }
+            #[cfg(target_os = "ios")]
+            {
+                app.hooks.audio_device = Some(Box::new(audio_out::open));
+                app.hooks.audio_devices = Some(Box::new(audio_out::devices));
+            }
+            app.ui.start_screen = false;
+            app.ui.status = status;
+            let failures = effectcraft_ui_egui::gpu_failure::GpuFailureBridge::new(&cc.egui_ctx);
+            if let Some(rs) = &cc.wgpu_render_state {
+                let errors = failures.clone();
+                rs.device.on_uncaptured_error(std::sync::Arc::new(move |error| {
+                    log::error!(target: "effectcraft_diagnostics", "uncaptured_metal_error: {error}");
+                    errors.report(&format!("Metal error: {error}"), false);
+                }));
+                let lost = failures.clone();
+                rs.device.set_device_lost_callback(move |reason, message| {
+                    log::error!(target: "effectcraft_diagnostics", "metal_device_lost: {reason:?} {message}");
+                    lost.report(&format!("Metal device lost ({reason:?}): {message}"), true);
+                });
+            }
+            app.set_gpu_failure_bridge(failures);
+            let files = files::Files::install(&mut app, &cc.egui_ctx);
+            let bridge = bridge::Bridge::install(&mut app, &cc.egui_ctx, files.native_documents());
+            let renders = render_files::RenderFiles::install(&mut app, &cc.egui_ctx, files.native_documents());
+            let requested = diagnostics::install(&mut app);
+            Ok(Box::new(diagnostics::DiagnosticApp {
+                requested,
+                app,
+                files,
+                bridge,
+                keyboard: keyboard::Keyboard::new(),
+                directory,
+                startup_error,
+                open: false,
+                previous: false,
+                text: String::new(),
+                last_playing: false,
+                lifecycle: lifecycle::Lifecycle::default(),
+                renders,
+            }))
+        }),
+    )
+}
