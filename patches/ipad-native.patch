+/// Validate user font files before adding any faces to the database.
+pub fn add_font_data_checked(data: Vec<u8>) -> Result<Vec<FaceId>, String> {
+    if data.len() > 32 * 1024 * 1024 {
+        return Err("Font exceeds 32 MB".into());
+    }
+    let names = read_faces_bytes(&data);
+    if names.is_empty() || names.len() > 64 {
+        return Err("Invalid TTF/OTF font or collection with more than 64 faces".into());
+    }
+    for name in &names {
+        if name.family.trim().is_empty() || name.family.len() > 512 || name.style.len() > 512 {
+            return Err("Invalid font family or style name".into());
+        }
+        let font = FontRef::from_index(&data, name.index).map_err(|e| format!("Invalid font: {e}"))?;
+        if font.metrics(Size::unscaled(), LocationRef::default()).units_per_em == 0
+            || font.glyph_metrics(Size::unscaled(), LocationRef::default()).advance_width(skrifa::GlyphId::new(0)).is_none() {
+            return Err(format!("Font has no usable glyph metrics: {}", name.family));
+        }
+    }
+    Ok(add_font_data(data))
