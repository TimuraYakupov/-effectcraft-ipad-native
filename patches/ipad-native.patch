index 00000000..d1455a87
--- /dev/null
+++ b/apps/effectcraft-ios/src/store_zip.rs
@@ -0,0 +1,157 @@
+//! Bounded streaming ZIP writer, stored entries (PKWARE APPNOTE 6.3).
+use std::collections::HashSet;
+use std::io::{Read, Seek, Write};
+use std::path::{Path, PathBuf};
+
+fn crc_bytes(mut value: u32, bytes: &[u8]) -> Result<u32, String> {
+    static TABLE: std::sync::OnceLock<[u32; 256]> = std::sync::OnceLock::new();
+    let table = TABLE.get_or_init(|| {
+        let mut table = [0_u32; 256];
+        for (i, slot) in table.iter_mut().enumerate() {
+            let mut c = i as u32;
+            for _ in 0..8 {
+                c = (c >> 1) ^ (0xedb88320_u32.wrapping_mul(c & 1));
+            }
+            *slot = c;
+        }
+        table
+    });
+    for byte in bytes {
+        value = (value >> 8) ^ table.get(((value ^ u32::from(*byte)) & 255) as usize).ok_or("Invalid CRC index")?;
+    }
+    Ok(value)
+}
+fn crc(path: &Path) -> Result<(u32, u32), String> {
+    let file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+    let length = u32::try_from(file.metadata().map_err(|e| e.to_string())?.len()).map_err(|_| "ZIP entry exceeds 4 GiB")?;
+    if u64::from(length) > 512 << 20 {
+        return Err("Bridge media exceeds 512 MiB".into());
+    }
+    let mut file = file.take(u64::from(length).saturating_add(1));
+    let mut read = 0_u64;
+    let mut value = !0_u32;
+    let mut buffer = [0_u8; 65536];
+    loop {
+        let n = file.read(&mut buffer).map_err(|e| e.to_string())?;
+        if n == 0 {
+            break;
+        }
+        read = read.saturating_add(n as u64);
+        value = crc_bytes(value, buffer.get(..n).ok_or("Invalid read size")?)?;
+    }
+    if read != u64::from(length) {
+        return Err("Media changed during ZIP export; retry".into());
+    }
+    Ok((!value, length))
+}
+fn u16le(w: &mut impl Write, value: u16) -> Result<(), String> {
+    w.write_all(&value.to_le_bytes()).map_err(|e| e.to_string())
+}
+fn u32le(w: &mut impl Write, value: u32) -> Result<(), String> {
+    w.write_all(&value.to_le_bytes()).map_err(|e| e.to_string())
+}
+
+pub fn write(output: &Path, entries: &[(String, PathBuf)]) -> Result<(), String> {
+    if entries.is_empty() || entries.len() > 4096 {
+        return Err("ZIP needs 1–4096 entries".into());
+    }
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(output).map_err(|e| e.to_string())?;
+    let result = (|| {
+        let mut names = HashSet::new();
+        let mut central = Vec::new();
+        let mut total = 0_u64;
+        for (name, path) in entries {
+            if !names.insert(name.clone()) {
+                return Err("Duplicate ZIP filename".into());
+            }
+            crate::project_zip::relative_name(name)?;
+            let name_len = u16::try_from(name.len()).map_err(|_| "ZIP filename too long")?;
+            let (checksum, size) = crc(path)?;
+            total = total.checked_add(u64::from(size)).ok_or("ZIP size overflow")?;
+            if total > 512 << 20 {
+                return Err("Bridge package exceeds 512 MiB".into());
+            }
+            let offset = u32::try_from(file.stream_position().map_err(|e| e.to_string())?).map_err(|_| "ZIP offset overflow")?;
+            u32le(&mut file, 0x04034b50)?;
+            for n in [20, 0x800, 0, 0, 0x21] {
+                u16le(&mut file, n)?;
+            }
+            for n in [checksum, size, size] {
+                u32le(&mut file, n)?;
+            }
+            u16le(&mut file, name_len)?;
+            u16le(&mut file, 0)?;
+            file.write_all(name.as_bytes()).map_err(|e| e.to_string())?;
+            let mut input = std::fs::File::open(path).map_err(|e| e.to_string())?.take(u64::from(size).saturating_add(1));
+            let mut buffer = [0_u8; 65536];
+            let mut copied = 0_u64;
+            let mut copied_crc = !0_u32;
+            loop {
+                let n = input.read(&mut buffer).map_err(|e| e.to_string())?;
+                if n == 0 {
+                    break;
+                }
+                let bytes = buffer.get(..n).ok_or("Invalid read size")?;
+                copied = copied.saturating_add(n as u64);
+                copied_crc = crc_bytes(copied_crc, bytes)?;
+                file.write_all(bytes).map_err(|e| e.to_string())?;
+            }
+            if copied != u64::from(size) || !copied_crc != checksum {
+                return Err("Media changed during ZIP export; retry".into());
+            }
+            central.push((name, name_len, checksum, size, offset));
+        }
+        let start = u32::try_from(file.stream_position().map_err(|e| e.to_string())?).map_err(|_| "ZIP offset overflow")?;
+        for (name, len, checksum, size, offset) in central {
+            u32le(&mut file, 0x02014b50)?;
+            for n in [20, 20, 0x800, 0, 0, 0x21] {
+                u16le(&mut file, n)?;
+            }
+            for n in [checksum, size, size] {
+                u32le(&mut file, n)?;
+            }
+            for n in [len, 0, 0, 0, 0] {
+                u16le(&mut file, n)?;
+            }
+            u32le(&mut file, 0)?;
+            u32le(&mut file, offset)?;
+            file.write_all(name.as_bytes()).map_err(|e| e.to_string())?;
+        }
+        let end = u32::try_from(file.stream_position().map_err(|e| e.to_string())?).map_err(|_| "ZIP offset overflow")?;
+        let count = u16::try_from(entries.len()).map_err(|_| "Too many ZIP entries")?;
+        u32le(&mut file, 0x06054b50)?;
+        for n in [0, 0, count, count] {
+            u16le(&mut file, n)?;
+        }
+        u32le(&mut file, end.checked_sub(start).ok_or("ZIP offset overflow")?)?;
+        u32le(&mut file, start)?;
+        u16le(&mut file, 0)?;
+        file.sync_all().map_err(|e| e.to_string())
+    })();
+    if result.is_err() {
+        drop(file);
+        let _ = std::fs::remove_file(output);
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn stored_zip_round_trips_through_the_bridge_importer() {
+        let root = std::env::temp_dir().join(format!("ec-zip-write-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let project = root.join("input.ecproj");
+        std::fs::write(&project, b"{\"schema\":2}").unwrap();
+        let media = root.join("input.bin");
+        std::fs::write(&media, [1, 2, 3, 4]).unwrap();
+        let archive = root.join("package.zip");
+        write(&archive, &[("Project.ecproj".into(), project), ("assets/clip.bin".into(), media)]).unwrap();
+        let restored = crate::project_zip::import(&archive, &root, &std::sync::atomic::AtomicBool::new(false)).unwrap();
+        assert_eq!(std::fs::read(restored.parent().unwrap().join("assets/clip.bin")).unwrap(), [1, 2, 3, 4]);
+        assert_eq!(std::fs::read(restored).unwrap(), b"{\"schema\":2}");
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
