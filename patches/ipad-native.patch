+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn idle_input_wakes_the_actual_egui_repaint_callback() {
+        use std::sync::{
+            Arc,
+            atomic::{AtomicUsize, Ordering},
+        };
+        let root = std::env::temp_dir().join(format!("ec-wake-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let ctx = egui::Context::default();
+        // Drain egui's initial two-pass repaint request before simulating idle.
+        for _ in 0..3 {
+            let mut output = ctx.run_ui(Default::default(), |_| {});
+            output.textures_delta.clear();
+        }
+        let count = Arc::new(AtomicUsize::new(0));
+        let observed = count.clone();
+        ctx.set_request_repaint_callback(move |_| {
+            observed.fetch_add(1, Ordering::Relaxed);
+        });
+        let flag = start_wake(root.clone(), "123-11".into(), ctx).unwrap();
+        std::fs::write(root.join("123-11-0001.key"), b"{}").unwrap();
+        let start = std::time::Instant::now();
+        while count.load(Ordering::Relaxed) == 0 && start.elapsed() < std::time::Duration::from_millis(300) {
+            std::thread::sleep(std::time::Duration::from_millis(5));
+        }
+        flag.store(false, Ordering::Relaxed);
+        assert!(count.load(Ordering::Relaxed) > 0, "idle eframe event loop was never woken");
+        let _ = std::fs::remove_dir_all(root);
+    }
+    #[test]
+    fn hover_and_secondary_click_preserve_order_and_do_not_become_primary_clicks() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        for down in [true, false] {
+            bridge.record(&json!({"kind":"pointer","x":42.5,"y":64.0,"down":down}), false, false, &mut events).unwrap();
+        }
+        assert_eq!(events.iter().filter(|e| matches!(e, Event::PointerButton { button: egui::PointerButton::Secondary, .. })).count(), 2);
+        assert!(!events.iter().any(|e| matches!(e, Event::PointerButton { button: egui::PointerButton::Primary, .. })));
+        assert!(bridge.record(&json!({"kind":"pointer","x":1e300,"y":0}), false, false, &mut events).is_err());
+    }
+    #[test]
+    fn primary_drag_survives_hover_exit_and_releases_on_cancel() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        bridge.record(&json!({"kind":"pointer","button":"primary","x":20,"y":30,"down":true}), false, false, &mut events).unwrap();
+        bridge.record(&json!({"kind":"pointer","phase":"gone"}), false, false, &mut events).unwrap();
+        bridge.record(&json!({"kind":"pointer","button":"primary","x":200,"y":300}), false, false, &mut events).unwrap();
+        assert!(bridge.primary_down);
+        assert!(!events.iter().any(|event| matches!(event, Event::PointerGone)));
+        bridge.record(&json!({"kind":"pointer","button":"primary","phase":"cancel","x":200,"y":300,"down":false}), false, false, &mut events).unwrap();
+        assert!(!bridge.primary_down);
+        let buttons: Vec<bool> = events.iter().filter_map(|event| match event {
+            Event::PointerButton { button: egui::PointerButton::Primary, pressed, .. } => Some(*pressed), _ => None,
+        }).collect();
+        assert_eq!(buttons, [true, false]);
+        assert!(matches!(events.last(), Some(Event::PointerGone)));
+    }
+    fn key(code: u32, down: bool, modifiers: u64) -> Value {
+        json!({"kind":"key","code":code,"down":down,"flags":modifiers})
+    }
+    #[test]
+    fn space_has_a_real_release_and_repeats_do_not_become_extra_taps() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        bridge.record(&key(44, true, 0), false, false, &mut events).unwrap();
+        bridge.record(&key(44, true, 0), false, false, &mut events).unwrap();
+        bridge.record(&key(44, false, 0), false, false, &mut events).unwrap();
+        let taps: Vec<_> = events.iter().filter_map(|e| if let Event::Key { pressed, repeat, .. } = e { Some((*pressed, *repeat)) } else { None }).collect();
+        assert_eq!(taps, vec![(true, false), (true, true), (false, false)]);
+        assert!(bridge.held.is_empty());
+    }
+    #[test]
+    fn command_and_control_chords_reach_shortcuts_with_russian_layout() {
+        for mask in [1 << 18, 1 << 20] {
+            let mut bridge = Keyboard::new();
+            let mut events = vec![];
+            let mut record = key(29, true, mask);
+            record["logical"] = json!("я");
+            bridge.record(&record, false, false, &mut events).unwrap();
+            assert!(events.iter().any(|e| matches!(e,Event::Key {key:Key::Z,modifiers,..} if modifiers.command)));
+        }
+    }
+    #[test]
+    fn text_focus_does_not_lose_captured_characters_or_turn_space_into_commands() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        let mut record = key(44, true, 0);
+        record["text"] = json!(" ");
+        bridge.record(&record, true, false, &mut events).unwrap();
+        assert!(events.contains(&Event::Text(" ".into())));
+        events.clear();
+        bridge.record(&key(76, true, 0), false, true, &mut events).unwrap();
+        assert!(!events.iter().any(|e| matches!(e, Event::Key { .. })));
+        assert!(bridge.held.is_empty());
+        assert_eq!(bridge.received, 2);
+        assert!(bridge.last_key.contains("Delete"));
+    }
+    #[test]
+    fn clipboard_and_focus_loss_are_single_events_not_duplicate_key_commands() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        bridge.record(&json!({"kind":"paste","code":25,"down":true,"flags":1<<20,"text":"hello"}), true, false, &mut events).unwrap();
+        assert_eq!(events.iter().filter(|e| matches!(e, Event::Paste(_))).count(), 1);
+        assert!(!events.iter().any(|e| matches!(e, Event::Key { pressed: true, .. })));
+        bridge.record(&key(44, true, 0), false, false, &mut events).unwrap();
+        events.clear();
+        bridge.record(&json!({"kind":"reset"}), false, false, &mut events).unwrap();
+        assert!(events.contains(&Event::WindowFocused(false)));
+        assert!(!events.iter().any(|e| matches!(e, Event::Key { key: Key::Space, pressed: false, .. })));
+    }
+    #[test]
+    fn translated_text_and_clipboard_edit_the_focused_widget_once() {
+        let ctx = egui::Context::default();
+        let id = egui::Id::new("keyboard-test-text");
+        let mut text = String::new();
+        let mut output = ctx.run_ui(Default::default(), |ui| {
+            egui::CentralPanel::default().show(ui, |ui| {
+                ui.add(egui::TextEdit::singleline(&mut text).id(id));
+            });
+            ui.ctx().memory_mut(|m| m.request_focus(id));
+        });
+        output.textures_delta.clear();
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        let mut space = key(44, true, 0);
+        space["text"] = json!(" ");
+        bridge.record(&space, true, false, &mut events).unwrap();
+        bridge.record(&key(44, false, 0), true, false, &mut events).unwrap();
+        bridge.record(&json!({"kind":"paste","code":25,"down":true,"flags":1<<20,"text":"hello"}), true, false, &mut events).unwrap();
+        let mut output = ctx.run_ui(egui::RawInput { events, ..Default::default() }, |ui| {
+            egui::CentralPanel::default().show(ui, |ui| {
+                ui.add(egui::TextEdit::singleline(&mut text).id(id));
+            });
+        });
+        output.textures_delta.clear();
+        assert_eq!(text, " hello");
+    }
+    #[test]
+    fn malformed_records_and_oversized_clipboard_are_recoverable() {
+        let mut bridge = Keyboard::new();
+        let mut events = vec![];
+        assert!(bridge.record(&json!({"kind":"key","code":u64::MAX,"down":true}), false, false, &mut events).is_err());
+        assert!(bridge.record(&json!({"kind":"paste","code":25,"down":true,"text":"x".repeat(MAX_CLIPBOARD+1)}), true, false, &mut events).is_err());
+    }
+}
