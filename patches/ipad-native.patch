index 00000000..93f9abf8
--- /dev/null
+++ b/apps/effectcraft-ios/src/files.rs
@@ -0,0 +1,677 @@
+//! App-local file dialogs, shared with Files through UIFileSharingEnabled.
+use std::collections::BTreeSet;
+use std::path::{Component, Path, PathBuf};
+use std::sync::mpsc::{self, Receiver};
+use std::sync::{
+    Arc,
+    atomic::{AtomicBool, Ordering},
+};
+
+use effectcraft_ui_egui::{DialogDone, EffectcraftApp, FileDialog};
+use eframe::egui;
+
+struct Request {
+    kind: FileDialog,
+    done: DialogDone,
+}
+struct Entry {
+    path: PathBuf,
+    folder: bool,
+}
+
+pub struct Files {
+    root: PathBuf,
+    dir: PathBuf,
+    inbox: Receiver<Request>,
+    active: Option<Request>,
+    entries: Vec<Entry>,
+    selected: BTreeSet<PathBuf>,
+    name: String,
+    error: String,
+    replace: Option<PathBuf>,
+    unpacking: Option<Receiver<Result<PathBuf, String>>>,
+    location: String,
+    cancel: Option<Arc<AtomicBool>>,
+    native: crate::native_documents::NativeDocuments,
+    native_pending: Option<String>,
+    local_root: PathBuf,
+    system: bool,
+    stage: Option<PathBuf>,
+    output_wait: Option<std::time::Instant>,
+    export_only: bool,
+}
+
+pub(crate) fn documents_folder(home: &Path) -> (PathBuf, String) {
+    // LiveContainer's guest HOME is inside its shared Documents/Data/Application/<id>.
+    // Put user projects beside Data, where Files can reach them without opening UUID folders.
+    let text = home.to_string_lossy();
+    if let Some((host, _)) = text.split_once("/Documents/Data/Application/") {
+        return (Path::new(host).join("Documents/EffectCraft"), "Files / On My iPad / LiveContainer / EffectCraft".into());
+    }
+    (home.join("Documents"), "Files / On My iPad / EC Native Preview".into())
+}
+
+pub fn save_path(root: &Path, dir: &Path, name: &str, ext: &str) -> Result<PathBuf, String> {
+    let dir = dir.canonicalize().map_err(|e| e.to_string())?;
+    let root = root.canonicalize().map_err(|e| e.to_string())?;
+    if !dir.starts_with(root) {
+        return Err("Choose a folder inside EffectCraft Documents".into());
+    }
+    let name = name.trim();
+    if name.is_empty()
+        || name.len() > 200
+        || name.starts_with('.')
+        || name.contains(['/', '\\', '\0'])
+        || Path::new(name).components().count() != 1
+        || !matches!(Path::new(name).components().next(), Some(Component::Normal(_)))
+    {
+        return Err("Enter a filename without folders (up to 200 bytes)".into());
+    }
+    let mut result = dir.join(name);
+    if result.extension().is_none() && !ext.is_empty() {
+        result.set_extension(ext);
+    }
+    if std::fs::symlink_metadata(&result).is_ok_and(|m| m.file_type().is_symlink() || m.is_dir()) {
+        return Err("Choose a regular file name".into());
+    }
+    Ok(result)
+}
+
+impl Files {
+    pub fn native_documents(&self) -> crate::native_documents::NativeDocuments {
+        self.native.clone()
+    }
+    pub fn is_open(&self) -> bool {
+        self.active.is_some() || self.export_only || self.native_pending.is_some() || self.unpacking.is_some()
+    }
+
+    pub fn install(app: &mut EffectcraftApp, ctx: &egui::Context) -> Self {
+        let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+        let (root, location) = documents_folder(&home);
+        let error = std::fs::create_dir_all(&root).err().map(|e| e.to_string()).unwrap_or_default();
+        let root = root.canonicalize().unwrap_or(root);
+        let native = crate::native_documents::NativeDocuments::new();
+        #[cfg(target_os = "ios")]
+        {
+            app.session.services = Arc::new(crate::native_documents::DocumentServices(native.clone()));
+        }
+        let (send, inbox) = mpsc::sync_channel::<Request>(8);
+        let wake = ctx.clone();
+        app.hooks.file_dialog_async = Some(Box::new(move |kind, done| {
+            if let Err(e) = send.try_send(Request { kind, done }) {
+                let request = match e {
+                    mpsc::TrySendError::Full(request) | mpsc::TrySendError::Disconnected(request) => request,
+                };
+                (request.done)(vec![]);
+                log::warn!("File dialog queue unavailable");
+            }
+            wake.request_repaint();
+        }));
+        Self {
+            local_root: root.clone(),
+            native,
+            native_pending: None,
+            system: false,
+            stage: None,
+            output_wait: None,
+            export_only: false,
+            dir: root.clone(),
+            root,
+            inbox,
+            active: None,
+            entries: vec![],
+            selected: BTreeSet::new(),
+            name: String::new(),
+            error,
+            replace: None,
+            unpacking: None,
+            location,
+            cancel: None,
+        }
+    }
+
+    fn refresh(&mut self) {
+        self.entries.clear();
+        self.selected.clear();
+        self.replace = None;
+        let listing = match std::fs::read_dir(&self.dir) {
+            Ok(v) => v,
+            Err(e) => {
+                self.error = e.to_string();
+                return;
+            }
+        };
+        let Some(request) = &self.active else { return };
+        for entry in listing.take(4096) {
+            let Ok(entry) = entry else { continue };
+            let Ok(kind) = entry.file_type() else { continue };
+            if kind.is_symlink() || entry.file_name().to_string_lossy().starts_with('.') {
+                continue;
+            }
+            let path = entry.path();
+            let ext = path.extension().map(|e| e.to_string_lossy().to_ascii_lowercase()).unwrap_or_default();
+            let visible = kind.is_dir()
+                || match &request.kind {
+                    FileDialog::Folder => false,
+                    FileDialog::OpenProject => matches!(ext.as_str(), "ecproj" | "ecprojx" | "xml" | "zip"),
+                    FileDialog::Open { exts, .. } => exts.is_empty() || exts.iter().any(|e| e.eq_ignore_ascii_case(&ext)),
+                    FileDialog::Save { .. } => true,
+                };
+            if visible && (kind.is_dir() || kind.is_file()) {
+                self.entries.push(Entry { path, folder: kind.is_dir() });
+            }
+        }
+        self.entries.sort_by(|a, b| b.folder.cmp(&a.folder).then_with(|| a.path.cmp(&b.path)));
+    }
+
+    fn finish(&mut self, paths: Vec<String>) {
+        if let Some(id) = self.native_pending.take() {
+            self.native.cancel(&id);
+        }
+        if let Some(cancel) = self.cancel.take() {
+            cancel.store(true, Ordering::Relaxed);
+        }
+        self.unpacking = None;
+        if let Some(path) = self.stage.take() {
+            let _ = std::fs::remove_file(&path);
+            if let Some(parent) = path.parent() {
+                let _ = std::fs::remove_dir(parent);
+            }
+        }
+        self.system = false;
+        self.output_wait = None;
+        self.export_only = false;
+        if let Some(request) = self.active.take() {
+            (request.done)(paths);
+        }
+    }
+
+    fn start_system(&mut self, app: &mut EffectcraftApp) -> Result<(), String> {
+        let Some(request) = &self.active else { return Ok(()) };
+        let id = match &request.kind {
+            FileDialog::OpenProject => self.native.open(false, None)?,
+            FileDialog::Open { many, .. } => self.native.open(*many, Some(&self.local_root.join("Imported Media")))?,
+            FileDialog::Folder => self.native.folder()?,
+            FileDialog::Save { default, ext, project } => {
+                let name = Path::new(default).file_name().and_then(|s| s.to_str()).unwrap_or("Project.ecproj");
+                let path = self.native.staging(name, ext)?;
+                self.stage = Some(path.clone());
+                if *project {
+                    // Prepare an export snapshot without changing the document's saved state.
+                    // The ordinary Save As command runs only after the destination is confirmed.
+                    let text = app.session.project.to_file_json_with_view(&app.session.saved_view()).map_err(|e| e.to_string())?;
+                    use effectcraft_engine::Services;
+                    effectcraft_engine::FsServices.write_file(&path.to_string_lossy(), text.as_bytes()).map_err(|e| e.to_string())?;
+                    self.native.export(&path)?
+                } else {
+                    // Other export commands generate their bytes through the engine first.
+                    // Cancelling the picker discards this new temporary output only.
+                    if let Some(request) = self.active.take() {
+                        (request.done)(vec![path.to_string_lossy().into_owned()]);
+                    }
+                    self.output_wait = Some(std::time::Instant::now());
+                    self.export_only = true;
+                    self.system = true;
+                    return Ok(());
+                }
+            }
+        };
+        self.native_pending = Some(id);
+        self.system = true;
+        Ok(())
+    }
+
+    fn choose(&mut self, ctx: &egui::Context) {
+        let Some(request) = &self.active else { return };
+        let paths = match &request.kind {
+            FileDialog::Folder => vec![self.dir.clone()],
+            FileDialog::Save { ext, .. } => match save_path(&self.root, &self.dir, &self.name, ext) {
+                Ok(path) => {
+                    if path.exists() && self.replace.as_ref() != Some(&path) {
+                        self.replace = Some(path);
+                        return;
+                    }
+                    vec![path]
+                }
+                Err(error) => {
+                    self.error = error;
+                    return;
+                }
+            },
+            _ => self.selected.iter().cloned().collect(),
+        };
+        if paths.is_empty() {
+            self.error = "Select a file first".into();
+            return;
+        }
+        if matches!(request.kind, FileDialog::OpenProject)
+            && let Some(path) = paths.first()
+        {
+            if path.extension().is_some_and(|e| e.eq_ignore_ascii_case("zip")) {
+                let archive = path.clone();
+                let docs = self.local_root.clone();
+                let (send, receive) = mpsc::channel();
+                let wake = ctx.clone();
+                let cancel = Arc::new(AtomicBool::new(false));
+                let native = self.native.clone();
+                self.cancel = Some(cancel.clone());
+                match std::thread::Builder::new().name("ec-project-import".into()).stack_size(8 << 20).spawn(move || {
+                    let result = native.copy_read(&archive).and_then(|copy| {
+                        let source = copy.as_ref().map(|c| c.path.as_path()).unwrap_or(archive.as_path());
+                        crate::project_zip::import(source, &docs, &cancel)
+                    });
+                    let _ = send.send(result);
+                    wake.request_repaint();
+                }) {
+                    Ok(_) => self.unpacking = Some(receive),
+                    Err(e) => self.error = e.to_string(),
+                }
+                return;
+            }
+            if std::fs::metadata(path).is_ok_and(|m| m.len() > 32 << 20) {
+                self.error = "Project file exceeds 32 MiB".into();
+                return;
+            }
+        }
+        self.finish(paths.iter().map(|p| p.to_string_lossy().into_owned()).collect());
+    }
+
+    pub fn show(&mut self, app: &mut EffectcraftApp, ctx: &egui::Context) {
+        if self.active.is_none()
+            && !self.export_only
+            && let Ok(request) = self.inbox.try_recv()
+        {
+            app.stop();
+            self.name = match &request.kind {
+                FileDialog::Save { default, .. } => {
+                    Path::new(default).file_name().map(|s| s.to_string_lossy().into_owned()).unwrap_or_else(|| "Project.ecproj".into())
+                }
+                _ => String::new(),
+            };
+            self.active = Some(request);
+            self.error.clear();
+            self.refresh();
+            if self.native.available() {
+                if let Err(error) = self.start_system(app) {
+                    self.error = error;
+                }
+            }
+        }
+        if let Some(started) = self.output_wait {
+            if let Some(path) = &self.stage
+                && path.is_file()
+                && app.session.render_job.is_none()
+                && std::fs::metadata(path)
+                    .and_then(|m| m.modified())
+                    .ok()
+                    .and_then(|t| t.elapsed().ok())
+                    .is_some_and(|elapsed| elapsed >= std::time::Duration::from_millis(500))
+            {
+                self.output_wait = None;
+                match self.native.export(path) {
+                    Ok(id) => self.native_pending = Some(id),
+                    Err(error) => {
+                        app.ui.status = error;
+                        self.finish(vec![]);
+                    }
+                }
+            } else if started.elapsed() > std::time::Duration::from_secs(120) && app.session.render_job.is_none() {
+                app.ui.status = "The export did not produce a file. Check the command error and try again.".into();
+                self.finish(vec![]);
+            }
+            ctx.request_repaint_after(std::time::Duration::from_millis(100));
+        }
+        if let Some(id) = self.native_pending.clone() {
+            match self.native.poll(&id) {
+                Some(Ok(value)) => {
+                    self.native_pending = None;
+                    if value["cancelled"].as_bool() == Some(true) {
+                        if self.active.as_ref().is_some_and(|r| matches!(r.kind, FileDialog::OpenProject | FileDialog::Open { .. })) {
+                            self.system = false;
+                            self.error = "System picker cancelled. Choose a local file below, or tap Browse iPad files to retry.".into();
+                            self.refresh();
+                            ctx.request_repaint();
+                            return;
+                        }
+                        self.finish(vec![]);
+                        return;
+                    }
+                    let paths: Vec<PathBuf> = value["paths"].as_array().into_iter().flatten().take(64).filter_map(|v| v.as_str().map(PathBuf::from)).collect();
+                    if paths.is_empty() {
+                        self.error = "The iPad Files window did not return a file".into();
+                        self.system = false;
+                    } else if self.export_only {
+                        app.ui.status = format!("Saved {}", paths.first().map(|p| p.to_string_lossy()).unwrap_or_default());
+                        self.finish(vec![]);
+                        return;
+                    } else {
+                        if self.active.as_ref().is_some_and(|r| !matches!(r.kind, FileDialog::Open { .. })) {
+                            for path in &paths {
+                                self.native.grant(path.clone());
+                            }
+                        }
+                        self.selected = paths.iter().cloned().collect();
+                        if self.active.as_ref().is_some_and(|r| matches!(r.kind, FileDialog::OpenProject)) {
+                            self.system = false;
+                            self.choose(ctx);
+                        } else {
+                            self.finish(paths.iter().map(|p| p.to_string_lossy().into_owned()).collect());
+                        }
+                    }
+                }
+                Some(Err(error)) => {
+                    self.native_pending = None;
+                    self.error = error;
+                    self.system = false;
+                    if self.export_only {
+                        app.ui.status = self.error.clone();
+                        self.finish(vec![]);
+                        return;
+                    }
+                }
+                None => ctx.request_repaint_after(std::time::Duration::from_millis(100)),
+            }
+        }
+        if self.system {
+            let mut cancel = false;
+            egui::Modal::new(egui::Id::new("ipad-system-files")).show(ctx, |ui| {
+                ui.heading("iPad Files");
+                ui.label(if self.unpacking.is_some() {
+                    "Unpacking project and media…"
+                } else if self.output_wait.is_some() {
+                    "Preparing file…"
+                } else {
+                    "Select a file or save location in the iPad Files window."
+                });
+                ui.spinner();
+                if ui.button("Cancel").clicked() {
+                    cancel = true;
+                }
+            });
+            if cancel {
+                self.finish(vec![]);
+            }
+            ctx.request_repaint_after(std::time::Duration::from_millis(100));
+            // Still poll the extraction worker below on subsequent frames.
+            if self.unpacking.is_none() {
+                return;
+            }
+        }
+        if let Some(receiver) = &self.unpacking {
+            match receiver.try_recv() {
+                Ok(Ok(path)) => {
+                    self.finish(vec![path.to_string_lossy().into_owned()]);
+                    return;
+                }
+                Ok(Err(error)) => {
+                    self.unpacking = None;
+                    self.error = error;
+                }
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    self.unpacking = None;
+                    self.error = "Project import stopped unexpectedly".into();
+                }
+                Err(mpsc::TryRecvError::Empty) => {
+                    ctx.request_repaint_after(std::time::Duration::from_millis(100));
+                }
+            }
+        }
+        let Some(request) = &self.active else { return };
+        let save = matches!(request.kind, FileDialog::Save { .. });
+        let many = matches!(request.kind, FileDialog::Open { many: true, .. });
+        let folder = matches!(request.kind, FileDialog::Folder);
+        let busy = self.unpacking.is_some() || self.native_pending.is_some();
+        let mut navigate = None;
+        let mut choose = false;
+        let mut cancel = false;
+        egui::Modal::new(egui::Id::new("ipad-file-picker")).show(ctx, |ui| {
+            ui.spacing_mut().interact_size.y = 40.0;
+            ui.spacing_mut().button_padding = egui::vec2(10.0, 8.0);
+            ui.spacing_mut().item_spacing.y = 7.0;
+            ui.style_mut().override_font_id = Some(egui::FontId::proportional(16.0));
+            ui.set_width(560.0_f32.min(ctx.content_rect().width() - 48.0).max(200.0));
+            ui.heading(if save {
+                "Save file"
+            } else if folder {
+                "Choose folder"
+            } else {
+                "Open file"
+            });
+            ui.label(&self.location);
+            ui.label("Browse iPad files opens the system file picker directly.");
+            ui.label("For Bridge ZIP: select the archive. Compressed ZIPs can be unpacked in Files first.");
+            ui.horizontal(|ui| {
+                if ui.add_enabled(!busy, egui::Button::new("Documents")).clicked() {
+                    self.root = self.local_root.clone();
+                    self.location = "EffectCraft documents".into();
+                    navigate = Some(self.local_root.clone());
+                }
+                let ready = self.native.available();
+                if ui.add_enabled(!busy && ready, egui::Button::new("Browse iPad files")).clicked() {
+                    choose = false;
+                    navigate = None;
+                    self.error.clear();
+                    // Started after drawing, so the dialog request is not borrowed here.
+                    self.system = true;
+                }
+                if !ready && cfg!(target_os = "ios") {
+                    ctx.request_repaint_after(std::time::Duration::from_millis(500));
+                }
+                if ui.add_enabled(!busy && self.dir != self.root, egui::Button::new("Up")).clicked() {
+                    navigate = self.dir.parent().map(Path::to_path_buf);
+                }
+                if ui.add_enabled(!busy, egui::Button::new("Refresh")).clicked() {
+                    navigate = Some(self.dir.clone());
+                }
+            });
+            ui.label(self.dir.strip_prefix(&self.root).unwrap_or(&self.dir).to_string_lossy());
+            ui.add_enabled_ui(!busy, |ui| {
+                egui::ScrollArea::vertical().max_height((ctx.content_rect().height() * 0.35).min(320.0)).show(ui, |ui| {
+                    for entry in &self.entries {
+                        let name = entry.path.file_name().map(|s| s.to_string_lossy()).unwrap_or_default();
+                        let label = if entry.folder { format!("Folder: {name}") } else { name.into_owned() };
+                        if ui.selectable_label(self.selected.contains(&entry.path), label).clicked() {
+                            if entry.folder {
+                                navigate = Some(entry.path.clone());
+                            } else if save {
+                                self.name = entry.path.file_name().map(|s| s.to_string_lossy().into_owned()).unwrap_or_default();
+                                self.replace = None;
+                            } else if many {
+                                if !self.selected.remove(&entry.path) {
+                                    self.selected.insert(entry.path.clone());
+                                }
+                            } else {
+                                self.selected.clear();
+                                self.selected.insert(entry.path.clone());
+                            }
+                        }
+                    }
+                    if self.entries.is_empty() {
+                        ui.label("No matching files. Copy files here in the Files app, then tap Refresh.");
+                    }
+                });
+                if save && ui.add(egui::TextEdit::singleline(&mut self.name).id_salt("ipad-save-name").hint_text("Filename")).changed() {
+                    self.replace = None;
+                }
+            });
+            if busy {
+                ui.label(if self.native_pending.is_some() { "Choose a file in the iPad Files window…" } else { "Unpacking project and media…" });
+                ui.spinner();
+            }
+            if !self.error.is_empty() {
+                ui.colored_label(egui::Color32::YELLOW, &self.error);
+            }
+            if self.replace.is_some() {
+                ui.colored_label(egui::Color32::YELLOW, "This file exists. Replace it?");
+            }
+            ui.horizontal(|ui| {
+                if ui
+                    .add_enabled(
+                        !busy,
+                        egui::Button::new(if self.replace.is_some() {
+                            "Replace existing file"
+                        } else if save {
+                            "Save"
+                        } else if folder {
+                            "Choose folder"
+                        } else {
+                            "Open"
+                        }),
+                    )
+                    .clicked()
+                {
+                    choose = true;
+                }
+                if ui.button("Cancel").clicked() {
+                    cancel = true;
+                }
+            });
+        });
+        if self.system && self.native_pending.is_none() && self.unpacking.is_none() {
+            if let Err(error) = self.start_system(app) {
+                self.system = false;
+                self.error = error;
+            }
+        } else if cancel {
+            self.finish(vec![]);
+        } else if let Some(path) = navigate {
+            match path.canonicalize() {
+                Ok(path) if path.starts_with(&self.root) => {
+                    self.dir = path;
+                    self.error.clear();
+                    self.refresh();
+                }
+                _ => self.error = "Folder is unavailable or outside Documents".into(),
+            }
+        } else if choose {
+            self.choose(ctx);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn livecontainer_uses_the_shared_effectcraft_folder() {
+        let (folder, hint) = documents_folder(Path::new("/private/var/mobile/Containers/Data/Application/HOST/Documents/Data/Application/GUEST"));
+        assert_eq!(folder, PathBuf::from("/private/var/mobile/Containers/Data/Application/HOST/Documents/EffectCraft"));
+        assert!(hint.contains("LiveContainer"));
+        assert_eq!(documents_folder(Path::new("/app/home")).0, PathBuf::from("/app/home/Documents"));
+    }
+
+    #[test]
+    fn picker_renders_and_cancel_finishes_the_async_request() {
+        let mut app = EffectcraftApp::new(effectcraft_engine::Session::default());
+        let root = std::env::temp_dir().join(format!("ec-picker-ui-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let (send, inbox) = mpsc::channel();
+        let (answer, received) = mpsc::channel();
+        send.send(Request {
+            kind: FileDialog::OpenProject,
+            done: Box::new(move |paths| {
+                answer.send(paths).unwrap();
+            }),
+        })
+        .unwrap();
+        let mut picker = Files {
+            root: root.clone(),
+            dir: root.clone(),
+            inbox,
+            active: None,
+            entries: vec![],
+            selected: BTreeSet::new(),
+            name: String::new(),
+            error: String::new(),
+            replace: None,
+            unpacking: None,
+            location: "Files / On My iPad / LiveContainer / EffectCraft".into(),
+            cancel: None,
+            native: crate::native_documents::NativeDocuments::new(),
+            native_pending: None,
+            system: false,
+            stage: None,
+            output_wait: None,
+            export_only: false,
+            local_root: root.clone(),
+        };
+        {
+            use egui_kittest::kittest::Queryable;
+            let mut harness = egui_kittest::Harness::builder().with_size(egui::vec2(1024.0, 768.0)).build_ui(|ui| {
+                if !ui.visuals().dark_mode {
+                    ui.ctx().set_visuals(egui::Visuals::dark());
+                }
+                picker.show(&mut app, ui.ctx());
+            });
+            harness.run();
+            if let Ok(path) = std::env::var("EC_FILE_PICKER_SNAPSHOT") {
+                harness.render().unwrap().save(path).unwrap();
+            }
+            harness.get_by_label("Cancel").click();
+            harness.run();
+        }
+        assert!(received.recv().unwrap().is_empty());
+        assert!(picker.active.is_none());
+        // Preparing the system Save As must not mark an unsaved document saved.
+        // On the host there is no UIKit bridge: exercise that failure and cancellation.
+        app.session.execute("comp.new", serde_json::json!({"name":"Unsaved comp", "width":64,"height":64,"duration":1})).unwrap();
+        assert!(app.session.is_dirty());
+        let original = app.session.path.clone();
+        let saved_revision = app.session.saved_revision;
+        let (answer, received) = mpsc::channel();
+        picker.active = Some(Request {
+            kind: FileDialog::Save { default: "My Project.ecproj".into(), ext: "ecproj".into(), project: true },
+            done: Box::new(move |paths| answer.send(paths).unwrap()),
+        });
+        assert!(picker.start_system(&mut app).is_err());
+        let snapshot = picker.stage.clone().unwrap();
+        let text = std::fs::read_to_string(&snapshot).unwrap();
+        assert!(effectcraft_engine::project::Project::from_json(&text).is_ok());
+        picker.finish(vec![]);
+        assert!(received.recv().unwrap().is_empty());
+        assert!(!snapshot.exists());
+        assert!(app.session.is_dirty());
+        assert_eq!(app.session.path, original);
+        assert_eq!(app.session.saved_revision, saved_revision);
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn project_save_reopen_and_failed_open_preserve_the_document() {
+        use serde_json::json;
+        let root = std::env::temp_dir().join(format!("ec-native-save-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let project = root.join("My Project.ecproj");
+        let mut session = effectcraft_engine::Session::default();
+        session.execute("comp.new", json!({"name":"My comp", "width":64,"height":64,"duration":1})).unwrap();
+        session.execute("file.saveAs", json!({"path":project})).unwrap();
+        assert!(!session.is_dirty());
+        let saved = std::fs::read(&project).unwrap();
+        let mut reopened = effectcraft_engine::Session::default();
+        reopened.execute("file.open", json!({"path":project})).unwrap();
+        assert_eq!(reopened.project.items.len(), session.project.items.len());
+        let before = reopened.project.clone();
+        let bad = root.join("bad.ecproj");
+        std::fs::write(&bad, b"not JSON").unwrap();
+        assert!(reopened.execute("file.open", json!({"path":bad})).is_err());
+        assert!(std::sync::Arc::ptr_eq(&before, &reopened.project));
+        let block = root.join("blocked");
+        std::fs::write(&block, b"not a folder").unwrap();
+        assert!(reopened.execute("file.saveAs", json!({"path":block.join("bad.ecproj")})).is_err());
+        assert_eq!(std::fs::read(&project).unwrap(), saved);
+        assert_eq!(reopened.path.as_deref(), project.to_str());
+        let _ = std::fs::remove_dir_all(root);
+    }
+    #[test]
+    fn save_names_stay_in_documents() {
+        let root = std::env::temp_dir().join(format!("ec-save-names-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        assert_eq!(save_path(&root, &root, "My Project", "ecproj").unwrap(), root.canonicalize().unwrap().join("My Project.ecproj"));
+        for bad in ["../bad", "/bad", "a/b", "a\\b", "", ".hidden"] {
+            assert!(save_path(&root, &root, bad, "ecproj").is_err());
+        }
+        assert!(save_path(&root, &std::env::temp_dir(), "bad", "ecproj").is_err());
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
