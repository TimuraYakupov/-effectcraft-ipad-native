+//! Imported media through desktop pointers and the native winit touch-release sequence.
+use crate::keyboard::Keyboard;
+use effectcraft_ui_egui::EffectcraftApp;
+use effectcraft_engine::project::{ItemKind, LayerSource};
+use eframe::egui::{self, pos2, vec2};
+use egui_kittest::Harness;
+use serde_json::json;
+
+#[derive(Clone, Copy, Debug)]
+enum InputPath { Mouse, NativeTouch, NativeTouchOutside, NativeTouchCancel }
+
+fn run_drop(target: &str, input: InputPath) {
+    let directory = std::env::temp_dir().join(format!("ec-media-drag-{}-{}-{input:?}", std::process::id(), target.replace('.', "-")));
+    std::fs::create_dir_all(&directory).unwrap();
+    let path = directory.join("Imported audio.wav");
+    let mut wav = Vec::new();
+    wav.extend_from_slice(b"RIFF"); wav.extend_from_slice(&16036_u32.to_le_bytes()); wav.extend_from_slice(b"WAVEfmt ");
+    wav.extend_from_slice(&16_u32.to_le_bytes()); wav.extend_from_slice(&1_u16.to_le_bytes()); wav.extend_from_slice(&1_u16.to_le_bytes());
+    wav.extend_from_slice(&8000_u32.to_le_bytes()); wav.extend_from_slice(&16000_u32.to_le_bytes());
+    wav.extend_from_slice(&2_u16.to_le_bytes()); wav.extend_from_slice(&16_u16.to_le_bytes());
+    wav.extend_from_slice(b"data"); wav.extend_from_slice(&16000_u32.to_le_bytes()); wav.resize(16044, 0);
+    std::fs::write(&path, wav).unwrap();
+    let mut session = effectcraft_host::session();
+    session.execute("comp.new", json!({"name":"Drop target", "width":640, "height":360, "duration":10, "frameRate":30})).unwrap();
+    session.execute("file.import", json!({"paths":[path]})).unwrap();
+    let item = *session.project.items.iter().find(|(_, item)| matches!(item.kind, ItemKind::Footage(_))).unwrap().0;
+    let mut harness = Harness::builder().with_size(vec2(1600.0, 1000.0)).build_eframe(|_| EffectcraftApp::new(session));
+    harness.run_steps(4);
+    let point = |h: &Harness<'_, EffectcraftApp>, id: &str| {
+        let e = h.state().auto.find(id).unwrap_or_else(|| panic!("missing {id}"));
+        pos2(e.rect[0] + e.rect[2] * 0.5, e.rect[1] + e.rect[3] * 0.5)
+    };
+    let from = point(&harness, &format!("project.item.{}.name", item.0));
+    let to = point(&harness, target);
+    let mut keyboard = Keyboard::new();
+    let send = |h: &mut Harness<'_, EffectcraftApp>, keyboard: &mut Keyboard, p: egui::Pos2, down: Option<bool>| {
+        if !matches!(input, InputPath::Mouse) {
+            let phase = match down {
+                Some(true) => egui::TouchPhase::Start,
+                Some(false) => if matches!(input, InputPath::NativeTouchCancel) { egui::TouchPhase::Cancel } else { egui::TouchPhase::End },
+                None => egui::TouchPhase::Move,
+            };
+            h.input_mut().events.push(egui::Event::Touch { device_id: egui::TouchDeviceId(1), id: egui::TouchId(1), phase, pos: p, force: None });
+            match down {
+                Some(false) => {
+                    if !matches!(input, InputPath::NativeTouchCancel) {
+                        h.input_mut().events.push(egui::Event::PointerButton { pos: p, button: egui::PointerButton::Primary, pressed: false, modifiers: egui::Modifiers::NONE });
+                    }
+                    h.input_mut().events.push(egui::Event::PointerGone);
+                }
+                _ => {
+                    h.input_mut().events.push(egui::Event::PointerMoved(p));
+                    if down == Some(true) {
+                        h.input_mut().events.push(egui::Event::PointerButton { pos: p, button: egui::PointerButton::Primary, pressed: true, modifiers: egui::Modifiers::NONE });
+                    }
+                }
+            }
+            h.step();
+            return;
+        }
+        let mut record = json!({"kind":"pointer", "button":"primary", "x":p.x, "y":p.y});
+        if let Some(down) = down { record["down"] = json!(down); }
+        let mut events = vec![];
+        keyboard.record(&record, false, false, &mut events).unwrap();
+        for event in events { h.input_mut().events.push(event); }
+        h.step();
+    };
+    harness.input_mut().events.push(egui::Event::PointerMoved(from));
+    harness.step();
+    send(&mut harness, &mut keyboard, from, Some(true));
+    for step in 1..=12 { send(&mut harness, &mut keyboard, from + (to - from) * (step as f32 / 12.0), None); }
+    let release = if matches!(input, InputPath::NativeTouchOutside) { pos2(-20.0, -20.0) } else { to };
+    if release != to { send(&mut harness, &mut keyboard, release, None); }
+    send(&mut harness, &mut keyboard, release, Some(false));
+    if matches!(input, InputPath::NativeTouch) {
+        harness.ctx.input(|i| {
+            assert!(i.pointer.hover_pos().is_none(), "release must reproduce disappearing iPad hover");
+            assert_eq!(i.pointer.interact_pos(), Some(release), "release position must remain available for interactions");
+        });
+    }
+    harness.run_steps(3);
+    let layers = &harness.state().session.active_comp().unwrap().layers;
+    if matches!(input, InputPath::NativeTouchOutside | InputPath::NativeTouchCancel) {
+        assert!(layers.is_empty(), "outside/cancelled drag must not add a layer");
+    } else {
+        assert_eq!(layers.len(), 1, "drop must add one layer at {target}");
+        assert!(matches!(layers[0].source, LayerSource::Footage { item: id } if id == item));
+        harness.state_mut().session.execute("edit.undo", json!({})).unwrap();
+        assert!(harness.state().session.active_comp().unwrap().layers.is_empty(), "drop must remain one undoable editor command");
+    }
+    drop(harness);
+    let _ = std::fs::remove_dir_all(directory);
+}
+#[test]
+fn imported_media_drag_to_composition_adds_one_editable_layer() { run_drop("viewer.comp", InputPath::Mouse); }
+#[test]
+fn imported_media_drag_to_timeline_adds_one_editable_layer() { run_drop("timeline.empty", InputPath::Mouse); }
+
+#[test]
+fn native_touch_release_to_composition_adds_one_editable_layer() { run_drop("viewer.comp", InputPath::NativeTouch); }
+#[test]
+fn native_touch_release_to_timeline_adds_one_editable_layer() { run_drop("timeline.empty", InputPath::NativeTouch); }
+#[test]
+fn native_touch_outside_does_not_add_a_layer() { run_drop("timeline.empty", InputPath::NativeTouchOutside); }
+#[test]
+fn native_touch_cancel_does_not_add_a_layer() { run_drop("viewer.comp", InputPath::NativeTouchCancel); }
