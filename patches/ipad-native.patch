+++ b/apps/effectcraft-ios/src/native_documents.rs
@@ -0,0 +1,221 @@
+//! Safe Rust side of the wrapper's UIKit folder picker and coordinated file access.
+use effectcraft_engine::Services;
+use serde_json::{Value, json};
+use std::path::{Path, PathBuf};
+use std::sync::{
+    Arc, Mutex,
+    atomic::{AtomicU64, Ordering},
+};
+use std::time::{Duration, Instant};
+
+static NEXT: AtomicU64 = AtomicU64::new(0);
+
+#[derive(Clone)]
+pub struct NativeDocuments {
+    directory: PathBuf,
+    grants: Arc<Mutex<Vec<PathBuf>>>,
+}
+
+pub struct ReadCopy {
+    pub path: PathBuf,
+}
+impl Drop for ReadCopy {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_file(&self.path);
+    }
+}
+
+impl NativeDocuments {
+    pub fn new() -> Self {
+        let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+        Self { directory: home.join("Library/Caches/EffectCraft/DocumentBridge8"), grants: Arc::default() }
+    }
+    pub fn lifecycle_path() -> PathBuf { Self::new().directory.join("lifecycle.txt") }
+    pub fn available(&self) -> bool {
+        if !cfg!(target_os = "ios") {
+            return false;
+        }
+        let Ok(data) = std::fs::read(self.directory.join("ready.json")) else { return false };
+        let Ok(value) = serde_json::from_slice::<Value>(&data) else { return false };
+        value["pid"].as_u64() == Some(std::process::id() as u64) && value["version"].as_u64() == Some(1)
+    }
+    pub fn granted(&self, path: &Path) -> bool {
+        if !path.is_absolute() || path.components().any(|c| matches!(c, std::path::Component::ParentDir)) { return false; }
+        if self.grants.lock().unwrap_or_else(std::sync::PoisonError::into_inner).iter().any(|root| path.starts_with(root)) { return true; }
+        self.restored_grants().iter().any(|root| path.starts_with(root))
+    }
+    fn restored_grants(&self) -> Vec<PathBuf> {
+        use std::io::Read;
+        let Ok(file) = std::fs::File::open(self.directory.join("ready.json")) else { return vec![] };
+        let mut data = Vec::new();
+        if file.take((2 << 20) + 1).read_to_end(&mut data).is_err() || data.len() > 2 << 20 { return vec![]; }
+        let Ok(value) = serde_json::from_slice::<Value>(&data) else { return vec![] };
+        if value["pid"].as_u64() != Some(std::process::id() as u64) || value["version"].as_u64() != Some(1) { return vec![]; }
+        value["grants"].as_array().into_iter().flatten().take(256).filter_map(Value::as_str)
+            .filter(|v| v.len() <= 16384).map(PathBuf::from).filter(|p| p.is_absolute() && !p.components().any(|c| matches!(c, std::path::Component::ParentDir))).collect()
+    }
+    pub fn grant(&self, path: PathBuf) {
+        let mut grants = self.grants.lock().unwrap_or_else(std::sync::PoisonError::into_inner);
+        if !grants.contains(&path) && grants.len() < 256 {
+            grants.push(path);
+        }
+    }
+    fn id(&self) -> String {
+        let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map(|d| d.as_nanos()).unwrap_or(0);
+        format!("{}-{stamp}-{}", std::process::id(), NEXT.fetch_add(1, Ordering::Relaxed))
+    }
+    fn submit(&self, id: &str, request: Value) -> Result<(), String> {
+        std::fs::create_dir_all(&self.directory).map_err(|e| e.to_string())?;
+        let data = serde_json::to_vec(&request).map_err(|e| e.to_string())?;
+        if data.len() > 16384 {
+            return Err("Document path is too long".into());
+        }
+        effectcraft_engine::FsServices.write_file(&self.directory.join(format!("{id}.request")).to_string_lossy(), &data).map_err(|e| e.to_string())
+    }
+    pub fn folder(&self) -> Result<String, String> {
+        self.pick(json!({"action":"folder"}))
+    }
+    pub fn open(&self, many: bool, import_to: Option<&Path>) -> Result<String, String> {
+        self.pick(json!({"action":"open", "many":many, "import_to":import_to}))
+    }
+    pub fn export(&self, file: &Path) -> Result<String, String> {
+        self.pick(json!({"action":"export", "path":file}))
+    }
+    pub fn export_copy(&self, file: &Path) -> Result<String, String> {
+        self.pick(json!({"action":"export", "path":file, "copy":true}))
+    }
+    fn pick(&self, request: Value) -> Result<String, String> {
+        if !self.available() {
+            return Err("System Files picker is not ready. Try again in a moment.".into());
+        }
+        let id = self.id();
+        self.submit(&id, request)?;
+        Ok(id)
+    }
+    pub fn staging(&self, name: &str, ext: &str) -> Result<PathBuf, String> {
+        let dir = self.directory.join(self.id());
+        std::fs::create_dir_all(&dir).map_err(|e| e.to_string())?;
+        crate::files::save_path(&dir, &dir, name, ext)
+    }
+    pub fn cancel(&self, id: &str) {
+        let _ = std::fs::write(self.directory.join(format!("{id}.cancel")), []);
+    }
+    pub fn poll(&self, id: &str) -> Option<Result<Value, String>> {
+        let path = self.directory.join(format!("{id}.response"));
+        if !path.exists() {
+            return None;
+        }
+        let result = std::fs::read(&path).map_err(|e| e.to_string()).and_then(|bytes| {
+            if bytes.len() > 32768 {
+                return Err("Invalid document response".into());
+            }
+            let value: Value = serde_json::from_slice(&bytes).map_err(|e| e.to_string())?;
+            if let Some(error) = value["error"].as_str() { Err(error.to_string()) } else { Ok(value) }
+        });
+        let _ = std::fs::remove_file(path);
+        Some(result)
+    }
+    fn wait(&self, id: &str) -> Result<Value, String> {
+        let start = Instant::now();
+        loop {
+            if let Some(result) = self.poll(id) {
+                let value = result?;
+                return if value["ok"].as_bool() == Some(true) { Ok(value) } else { Err("Document operation was cancelled".into()) };
+            }
+            if start.elapsed() > Duration::from_secs(60) {
+                return Err("The file provider did not respond. Try again after downloading the file in Files.".into());
+            }
+            std::thread::sleep(Duration::from_millis(20));
+        }
+    }
+    pub fn copy_read(&self, path: &Path) -> Result<Option<ReadCopy>, String> {
+        if !self.granted(path) {
+            return Ok(None);
+        }
+        let id = self.id();
+        self.submit(&id, json!({"action":"read","path":path}))?;
+        let output = self.directory.join(format!("{id}.data"));
+        if let Err(e) = self.wait(&id) {
+            let _ = std::fs::remove_file(&output);
+            return Err(e);
+        }
+        Ok(Some(ReadCopy { path: output }))
+    }
+    fn write(&self, path: &str, data: &[u8]) -> Result<(), String> {
+        let id = self.id();
+        let staging = self.directory.join(format!("{id}.data"));
+        std::fs::create_dir_all(&self.directory).map_err(|e| e.to_string())?;
+        effectcraft_engine::FsServices.write_file(&staging.to_string_lossy(), data).map_err(|e| e.to_string())?;
+        let result = self.submit(&id, json!({"action":"write","path":path})).and_then(|_| self.wait(&id)).map(|_| ());
+        let _ = std::fs::remove_file(staging);
+        result
+    }
+}
+
+pub struct DocumentServices(pub NativeDocuments);
+impl Services for DocumentServices {
+    fn read_file(&self, path: &str) -> std::io::Result<Vec<u8>> {
+        let copy = self.0.copy_read(Path::new(path)).map_err(std::io::Error::other)?;
+        let input = copy.as_ref().map(|c| c.path.as_path()).unwrap_or_else(|| Path::new(path));
+        if std::fs::metadata(input)?.len() > 128 << 20 {
+            return Err(std::io::Error::other("Document exceeds 128 MiB"));
+        }
+        std::fs::read(input)
+    }
+    fn write_file(&self, path: &str, data: &[u8]) -> std::io::Result<()> {
+        if self.0.granted(Path::new(path)) {
+            self.0.write(path, data).map_err(std::io::Error::other)
+        } else {
+            effectcraft_engine::FsServices.write_file(path, data)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn local_documents_keep_atomic_filesystem_services() {
+        let path = std::env::temp_dir().join(format!("ec-native-service-{}.ecproj", std::process::id()));
+        let services = DocumentServices(NativeDocuments::new());
+        services.write_file(path.to_str().unwrap(), b"{}").unwrap();
+        assert_eq!(services.read_file(path.to_str().unwrap()).unwrap(), b"{}");
+        let _ = std::fs::remove_file(path);
+    }
+    #[test]
+    fn grants_do_not_include_sibling_paths() {
+        let b = NativeDocuments::new();
+        b.grant(PathBuf::from("/docs/one"));
+        assert!(b.granted(Path::new("/docs/one/a.ecproj")));
+        assert!(!b.granted(Path::new("/docs/one-more/a.ecproj")));
+        assert!(!b.granted(Path::new("/docs/one/../../escape.ecproj")));
+    }
+    #[test]
+    fn restored_grants_require_current_process_and_whole_path_components() {
+        let dir = std::env::temp_dir().join(format!("ec-restored-grants-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let b = NativeDocuments { directory: dir.clone(), grants: Arc::default() };
+        let ready = dir.join("ready.json");
+        std::fs::write(&ready, serde_json::to_vec(&json!({"pid":std::process::id(),"version":1,"grants":["/external/project","/unsafe/../folder","relative"]})).unwrap()).unwrap();
+        assert!(b.granted(Path::new("/external/project/test.ecproj")));
+        assert!(!b.granted(Path::new("/external/project-other/test.ecproj")));
+        assert!(!b.granted(Path::new("/unsafe/../folder/test.ecproj")));
+        std::fs::write(&ready, br#"{"pid":0,"version":1,"grants":["/external/project"]}"#).unwrap();
+        assert!(!b.granted(Path::new("/external/project/test.ecproj")));
+        let _ = std::fs::remove_dir_all(dir);
+    }
+    #[test]
+    fn response_errors_and_cancellation_are_not_successful_writes() {
+        let dir = std::env::temp_dir().join(format!("ec-native-bridge-test-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let b = NativeDocuments { directory: dir.clone(), grants: Arc::default() };
+        std::fs::write(dir.join("1.response"), br#"{"error":"permission denied"}"#).unwrap();
+        assert!(b.poll("1").unwrap().is_err());
+        assert!(!dir.join("1.response").exists());
+        std::fs::write(dir.join("2.response"), br#"{"cancelled":true}"#).unwrap();
+        assert!(b.poll("2").unwrap().unwrap()["cancelled"].as_bool().unwrap());
+        std::fs::write(dir.join("3.response"), br#"{"cancelled":true}"#).unwrap();
+        assert!(b.wait("3").is_err());
+        let _ = std::fs::remove_dir_all(dir);
+    }
+}
