index 00000000..536a1b26
--- /dev/null
+++ b/apps/effectcraft-ios/src/journal.rs
@@ -0,0 +1,41 @@
+//! Bounded journal reading, also testable without a UI or Apple SDK.
+use std::io::{Read, Seek, SeekFrom};
+use std::path::{Path, PathBuf};
+
+const MAX_TAIL: u64 = 64 * 1024;
+
+pub fn log_directory() -> PathBuf {
+    std::env::var_os("HOME").map(PathBuf::from).map(|p| p.join("Documents")).unwrap_or_else(std::env::temp_dir).join("EffectCraftDiagnostics/Logs")
+}
+
+pub fn read_tail(path: &Path) -> Result<String, String> {
+    let mut file = std::fs::File::open(path).map_err(|e| e.to_string())?;
+    let length = file.metadata().map_err(|e| e.to_string())?.len();
+    file.seek(SeekFrom::Start(length.saturating_sub(MAX_TAIL))).map_err(|e| e.to_string())?;
+    let mut bytes = Vec::new();
+    file.take(MAX_TAIL).read_to_end(&mut bytes).map_err(|e| e.to_string())?;
+    Ok(String::from_utf8_lossy(&bytes).into_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn journal_tail_is_bounded_and_survives_invalid_utf8() {
+        let path = std::env::temp_dir().join(format!("ec-diag-tail-{}", std::process::id()));
+        let mut bytes = vec![b'a'; MAX_TAIL as usize + 10];
+        bytes.extend_from_slice(&[0xff, b'\n', b'z']);
+        std::fs::write(&path, &bytes).unwrap();
+        let text = read_tail(&path).unwrap();
+        assert!(text.ends_with("\nz"));
+        assert!(text.len() <= MAX_TAIL as usize + 2);
+        std::fs::remove_file(path).unwrap();
+    }
+
+    #[test]
+    fn missing_journal_is_a_recoverable_error() {
+        let path = std::env::temp_dir().join(format!("ec-diag-absent-{}", std::process::id()));
+        assert!(read_tail(&path).is_err());
+    }
+}
