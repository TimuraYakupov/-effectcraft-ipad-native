+  } catch (error) {
+    bridgeMenuLoadError070 = 'ZIP commands unavailable: ' + (error?.message || String(error));
+  }
+}
+export function bridgeMenuState() {
+  const fallback = {importEnabled:false,exportEnabled:false,saveEnabled:false,
+    status:bridgeMenuLoadError070 || 'ZIP commands are loading…'};
+  try {
+    const bridge = window.EffectCraftBridgeIpad;
+    if (!bridge || typeof bridge.menuState !== 'function') {
+      requestBridgeMenuLoad070();
+      return JSON.stringify(fallback);
+    }
+    const state = bridge.menuState();
+    if (!state || typeof state !== 'object') throw new Error('Invalid ZIP command state');
+    return JSON.stringify({importEnabled:state.importEnabled === true,
+      exportEnabled:state.exportEnabled === true,saveEnabled:state.saveEnabled === true,
+      fontsEnabled:state.fontsEnabled === true,
+      status:typeof state.status === 'string' ? state.status : ''});
+  } catch (error) {
+    fallback.status = 'ZIP commands unavailable: ' + (error?.message || String(error));
+    return JSON.stringify(fallback);
+  }
+}
+export function bridgeMenuAction(command) {
+  const bridge = window.EffectCraftBridgeIpad;
+  if (!bridge || typeof bridge.runCommand !== 'function')
+    throw new Error('ZIP commands are not ready. Close and reopen EffectCraft.');
+  bridge.runCommand(command);
+}
