new file mode 100644
index 00000000..3e06e384
--- /dev/null
+++ b/apps/effectcraft-ios/src/diagnostics.rs
@@ -0,0 +1,236 @@
+//! Bounded, persistent diagnostics available without iPadOS Analytics reports.
+use std::path::PathBuf;
+
+use effectcraft_ui_egui::EffectcraftApp;
+use eframe::egui;
+
+pub fn install(app: &mut EffectcraftApp) -> std::rc::Rc<std::cell::Cell<bool>> {
+    let requested = std::rc::Rc::new(std::cell::Cell::new(false));
+    let flag = requested.clone();
+    app.hooks.diagnostics = Some(Box::new(move || flag.set(true)));
+    requested
+}
+
+pub struct DiagnosticApp {
+    pub requested: std::rc::Rc<std::cell::Cell<bool>>,
+    pub app: EffectcraftApp,
+    pub files: crate::files::Files,
+    pub bridge: crate::bridge::Bridge,
+    pub keyboard: crate::keyboard::Keyboard,
+    pub directory: PathBuf,
+    pub startup_error: Option<String>,
+    pub open: bool,
+    pub previous: bool,
+    pub text: String,
+    pub last_playing: bool,
+    pub lifecycle: crate::lifecycle::Lifecycle,
+    pub renders: crate::render_files::RenderFiles,
+}
+
+impl DiagnosticApp {
+    fn set_disk(&mut self, enabled: bool, gib: u32) {
+        self.app.stop();
+        self.app.session.prefs.disk.disk_cache_enabled = enabled;
+        self.app.session.prefs.disk.disk_cache_max_gb = gib.clamp(1, 4);
+        self.app.session.prefs_changed();
+        self.app.session.save_prefs();
+        if enabled && self.app.session.disk_cache.is_none() {
+            self.app.ui.status = "Disk cache could not open. Preview is using RAM; details are in the log.".into();
+        }
+        log::info!(target: "effectcraft_diagnostics", "disk_enabled={enabled} disk_gib={}", gib.clamp(1, 4));
+    }
+
+    fn set_cache(&mut self, mib: u32) {
+        let mib = mib.clamp(64, 2048);
+        self.app.stop();
+        self.app.session.prefs.memory.preview_cache_mb = mib;
+        self.app.session.prefs_changed();
+        self.app.session.save_prefs();
+        self.app.frames.set_budget((mib as usize) << 20);
+        log::info!(target: "effectcraft_diagnostics", "preview_cache_limit_mib={mib}");
+    }
+
+    fn refresh(&mut self) {
+        let name = if self.previous { "effectcraft.1.log" } else { "effectcraft.log" };
+        self.text = crate::journal::read_tail(&self.directory.join(name)).unwrap_or_else(|e| format!("Cannot read {name}: {e}"));
+    }
+}
+
+impl eframe::App for DiagnosticApp {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.app.logic(ctx, frame);
+        if self.last_playing != self.app.playback.playing {
+            self.last_playing = self.app.playback.playing;
+            log::info!(target: "effectcraft_diagnostics", "playback playing={}", self.last_playing);
+        }
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, input: &mut egui::RawInput) {
+        self.lifecycle.input(&mut self.app, input.focused);
+        if let Err(error) = self.keyboard.input(ctx, input, self.files.is_open() || self.bridge.is_open() || self.renders.is_open() || self.open) {
+            self.app.ui.status = error;
+        }
+        self.app.raw_input_hook(ctx, input);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.app.ui(ui, frame);
+        let ctx = ui.ctx();
+        if self.requested.replace(false) {
+            self.open = true;
+            self.refresh();
+        }
+        if self.open {
+            ctx.request_repaint_after(std::time::Duration::from_millis(100));
+            let mut open = self.open;
+            egui::Window::new("Diagnostics · build 16").open(&mut open).default_width(650.0).vscroll(true).show(ctx, |ui| {
+                ui.strong("Hardware keyboard — press Space here to test (project commands disabled)");
+                ui.label(&self.keyboard.native_status);
+                ui.label(format!("Editor received: {} · {}", self.keyboard.received, self.keyboard.last_key));
+                ui.label(format!("Pointer events received: {}", self.keyboard.pointer_received));
+                ui.separator();
+                ui.label("One render worker · layer/media caches: 64 MiB each");
+                ui.horizontal(|ui| {
+                    ui.label("Preview cache:");
+                    let current = self.app.frames.budget() >> 20;
+                    for mib in [256_u32, 512, 1024, 2048] {
+                        if ui.selectable_label(current == mib as usize, format!("{mib} MiB")).clicked() {
+                            self.set_cache(mib);
+                        }
+                    }
+                });
+                if let Some(c) = self.app.frames.cache_usage() {
+                    ui.label(format!(
+                        "Cached: {} frames · {:.1} / {:.0} MiB total (GPU: {:.1} MiB)",
+                        c.frames,
+                        c.bytes as f64 / 1048576.0,
+                        c.budget as f64 / 1048576.0,
+                        c.gpu_bytes as f64 / 1048576.0
+                    ));
+                }
+                ui.separator();
+                let mut disk_enabled = self.app.session.prefs.disk.disk_cache_enabled;
+                let disk_gib = self.app.session.prefs.disk.disk_cache_max_gb;
+                if ui.checkbox(&mut disk_enabled, "Use disk cache").changed() {
+                    self.set_disk(disk_enabled, disk_gib);
+                }
+                ui.horizontal(|ui| {
+                    ui.label("Disk limit:");
+                    for gib in [1_u32, 2, 4] {
+                        if ui.selectable_label(disk_gib == gib, format!("{gib} GiB")).clicked() {
+                            self.set_disk(disk_enabled, gib);
+                        }
+                    }
+                });
+                if let Some(dc) = self.app.session.disk_cache.clone() {
+                    let stats = dc.stats();
+                    ui.label(format!(
+                        "Disk: {} frames · {:.1} / {:.0} MiB · reads: {} · writes: {}",
+                        dc.keys(effectcraft_engine::render::disk_cache::Kind::Frame).len(),
+                        stats.bytes as f64 / 1048576.0,
+                        stats.max_bytes as f64 / 1048576.0,
+                        stats.hits,
+                        stats.writes
+                    ));
+                    if stats.errors > 0 {
+                        ui.colored_label(
+                            egui::Color32::YELLOW,
+                            "Disk writes failed. Free storage or turn disk cache off and on to retry. RAM preview still works.",
+                        );
+                    } else if !stats.can_prefetch() {
+                        ui.label("Disk cache is nearly full. Increase its limit or clear it to keep caching.");
+                    }
+                    if ui.button("Clear disk cache").clicked() {
+                        self.app.stop();
+                        if let Err(error) = effectcraft_ui_egui::menus::invoke(&mut self.app, ctx, "edit.purge", serde_json::json!({"what":"disk"})) {
+                            self.app.ui.status = error;
+                        }
+                    }
+                } else if disk_enabled {
+                    ui.colored_label(egui::Color32::YELLOW, "Disk cache unavailable. Preview is using RAM.");
+                }
+                ui.label("Green = RAM · Blue = disk. Cached frames survive relaunch; iPadOS may reclaim disk cache.");
+                ui.separator();
+                let mut idle = self.app.session.prefs.previews.cache_frames_when_idle;
+                if ui.checkbox(&mut idle, "Cache frames while idle").changed() {
+                    self.app.session.prefs.previews.cache_frames_when_idle = idle;
+                    self.app.session.prefs_changed();
+        self.app.session.save_prefs();
+                    log::info!(target: "effectcraft_diagnostics", "idle_cache={idle}");
+                }
+                ui.horizontal(|ui| {
+                    ui.label("Preview quality:");
+                    use effectcraft_ui_egui::state::Resolution;
+                    for (resolution, command) in
+                        [(Resolution::Full, "view.res.full"), (Resolution::Half, "view.res.half"), (Resolution::Quarter, "view.res.quarter")]
+                    {
+                        if ui.selectable_label(self.app.viewer_res() == resolution, resolution.label()).clicked() {
+                            self.app.stop();
+                            if let Err(error) = effectcraft_ui_egui::menus::invoke(&mut self.app, ctx, command, serde_json::json!({})) {
+                                self.app.ui.status = error;
+                            }
+                        }
+                    }
+                });
+                ui.label("Half fits about 4× more frames; Quarter about 16×. Quality changes affect preview only.");
+                ui.separator();
+                ui.label("After a crash, relaunch once and select Previous run. The last two runs are kept.");
+                if let Some(error) = &self.startup_error {
+                    ui.colored_label(egui::Color32::RED, format!("Log setup failed: {error}"));
+                }
+                ui.horizontal(|ui| {
+                    if ui.selectable_label(!self.previous, "Current run").clicked() {
+                        self.previous = false;
+                        self.refresh();
+                    }
+                    if ui.selectable_label(self.previous, "Previous run").clicked() {
+                        self.previous = true;
+                        self.refresh();
+                    }
+                    if ui.button("Refresh").clicked() {
+                        self.refresh();
+                    }
+                    if ui.button("Copy log").clicked() {
+                        ctx.copy_text(self.text.clone());
+                    }
+                });
+                ui.label(self.directory.to_string_lossy());
+                egui::ScrollArea::both().max_height(380.0).stick_to_bottom(true).show(ui, |ui| {
+                    ui.add(egui::Label::new(egui::RichText::new(&self.text).monospace()).selectable(true));
+                });
+            });
+            self.open = open;
+        }
+        self.renders.show(&mut self.app, ctx);
+        self.files.show(&mut self.app, ctx);
+        self.bridge.show(&mut self.app, ctx);
+        // Diagnostics keeps native capture active for its live key counter; the
+        // input hook suppresses project commands while that window is open.
+        if let Err(error) = self.keyboard.output(ctx, self.files.is_open() || self.bridge.is_open() || self.renders.is_open()) {
+            self.app.ui.status = error;
+        }
+    }
+
+    fn on_exit(&mut self) {
+        log::info!(target: "effectcraft_diagnostics", "clean_exit");
+        self.app.session.save_prefs();
+        let _ = self.app.session.autosave_wait();
+        self.app.on_exit();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    #[test]
+    fn diagnostics_are_opened_by_help_command_only_when_installed() {
+        let mut app = effectcraft_ui_egui::EffectcraftApp::new(effectcraft_engine::Session::default());
+        let ctx = eframe::egui::Context::default();
+        assert!(effectcraft_ui_egui::menus::invoke(&mut app, &ctx, "platform.diagnostics", serde_json::json!({})).is_err());
+        let requested = super::install(&mut app);
+        assert!(!requested.get());
+        let entry = effectcraft_ui_egui::menus::menu_items(&app).into_iter().find(|e| e.id == "platform.diagnostics").unwrap();
+        assert_eq!(entry.path, ["Help"]);
+        effectcraft_ui_egui::menus::invoke(&mut app, &ctx, "platform.diagnostics", serde_json::json!({})).unwrap();
+        assert!(requested.get());
+    }
+}
