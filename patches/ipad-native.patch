diff --git a/apps/effectcraft-ios/src/bridge.rs b/apps/effectcraft-ios/src/bridge.rs
new file mode 100644
index 00000000..7c34dae3
--- /dev/null
+++ b/apps/effectcraft-ios/src/bridge.rs
@@ -0,0 +1,318 @@
+//! Native implementation of the same File-menu Bridge commands as the web host.
+use crate::native_documents::NativeDocuments;
+use effectcraft_ui_egui::{
+    EffectcraftApp,
+    menus::{self, BridgeState},
+};
+use eframe::egui;
+use serde_json::{Value, json};
+use std::{
+    cell::RefCell,
+    path::{Path, PathBuf},
+    rc::Rc,
+    sync::mpsc::{self, Receiver},
+};
+
+enum Done {
+    Zip(PathBuf),
+    Fonts(String),
+}
+enum Pending {
+    Fonts(String, PathBuf),
+    Save(String),
+}
+pub struct Bridge {
+    state: Rc<RefCell<BridgeState>>,
+    commands: Receiver<String>,
+    work: Option<Receiver<Result<Done, String>>>,
+    pending: Option<Pending>,
+    prepared: Option<PathBuf>,
+    native: NativeDocuments,
+    documents: PathBuf,
+}
+pub fn documents() -> PathBuf {
+    let home = std::env::var_os("HOME").map(PathBuf::from).unwrap_or_else(std::env::temp_dir);
+    crate::files::documents_folder(&home).0
+}
+impl Bridge {
+    pub fn install(app: &mut EffectcraftApp, ctx: &egui::Context, native: NativeDocuments) -> Self {
+        let state = Rc::new(RefCell::new(BridgeState { import_enabled: true, export_enabled: true, fonts_enabled: true, ..Default::default() }));
+        let observed = state.clone();
+        app.hooks.bridge_state = Some(Box::new(move || Some(observed.borrow().clone())));
+        let (send, commands) = mpsc::sync_channel(8);
+        let wake = ctx.clone();
+        app.hooks.bridge_action = Some(Box::new(move |id| {
+            send.try_send(id.to_string()).map_err(|_| "Bridge is busy".to_string())?;
+            wake.request_repaint();
+            Ok(())
+        }));
+        Self { state, commands, work: None, pending: None, prepared: None, native, documents: documents() }
+    }
+    pub fn is_open(&self) -> bool {
+        self.work.is_some() || self.pending.is_some()
+    }
+    fn spawn(&mut self, ctx: &egui::Context, job: impl FnOnce() -> Result<Done, String> + Send + 'static) -> Result<(), String> {
+        let (send, receive) = mpsc::sync_channel(1);
+        let wake = ctx.clone();
+        std::thread::Builder::new()
+            .name("ec-bridge".into())
+            .stack_size(8 << 20)
+            .spawn(move || {
+                let result = job();
+                let _ = send.send(result);
+                wake.request_repaint();
+            })
+            .map_err(|e| e.to_string())?;
+        self.work = Some(receive);
+        Ok(())
+    }
+    fn command(&mut self, id: &str, app: &mut EffectcraftApp, ctx: &egui::Context) -> Result<(), String> {
+        if self.is_open() {
+            return Err("Wait for the current Bridge operation".into());
+        }
+        match id {
+            "bridge.importAEZip" => {
+                menus::invoke(app, ctx, "file.open", json!({}))?;
+            }
+            "bridge.exportProjectZip" => {
+                app.stop();
+                if let Some(old) = self.prepared.take() {
+                    let _ = std::fs::remove_file(&old);
+                    if let Some(parent) = old.parent() {
+                        let _ = std::fs::remove_dir(parent);
+                    }
+                }
+                let project = app.session.project.clone();
+                let view = app.session.saved_view();
+                let output = self.native.staging("EffectCraft-Bridge.zip", "zip")?;
+                let native = self.native.clone();
+                self.spawn(ctx, move || {
+                    let text = project.to_file_json_with_view(&view).map_err(|e| e.to_string())?;
+                    if text.len() > 32 << 20 {
+                        return Err("Project JSON exceeds 32 MiB".into());
+                    }
+                    export(text, &output, &native).map(Done::Zip)
+                })?;
+                app.ui.status = "Packaging project and media for After Effects…".into();
+            }
+            "bridge.saveZipToFiles" => {
+                let path = self.prepared.as_ref().ok_or("Export Project ZIP first")?;
+                self.pending = Some(Pending::Save(self.native.export_copy(path)?));
+            }
+            "bridge.importFonts" => {
+                app.stop();
+                let path = self.native.staging("Fonts", "directory")?;
+                let folder = path.parent().ok_or("Font staging folder unavailable")?.join("Font Imports");
+                self.pending = Some(Pending::Fonts(self.native.open(true, Some(&folder))?, folder));
+            }
+            _ => return Err("Unknown Bridge action".into()),
+        }
+        Ok(())
+    }
+    pub fn show(&mut self, app: &mut EffectcraftApp, ctx: &egui::Context) {
+        if let Ok(command) = self.commands.try_recv() {
+            if let Err(error) = self.command(&command, app, ctx) {
+                app.ui.status = error;
+            }
+        }
+        if let Some(pending) = &self.pending {
+            let id = match pending {
+                Pending::Fonts(id, _) | Pending::Save(id) => id,
+            };
+            if let Some(result) = self.native.poll(id) {
+                let pending = self.pending.take();
+                match (pending, result) {
+                    (Some(Pending::Fonts(_, folder)), Ok(value)) if value["cancelled"].as_bool() != Some(true) => {
+                        let paths: Vec<PathBuf> = value["paths"].as_array().into_iter().flatten().filter_map(Value::as_str).map(PathBuf::from).collect();
+                        let root = self.documents.join("Fonts");
+                        if let Err(error) = self.spawn(ctx, move || {
+                            let result = crate::user_fonts::import(&root, &paths).map(Done::Fonts);
+                            // This is the per-operation cache folder, never the original files.
+                            let _ = std::fs::remove_dir_all(&folder);
+                            result
+                        }) {
+                            app.ui.status = error;
+                        }
+                    }
+                    (_, Ok(value)) => {
+                        app.ui.status = if value["cancelled"].as_bool() == Some(true) {
+                            "Bridge file selection cancelled".into()
+                        } else {
+                            "Bridge ZIP saved to Files".into()
+                        };
+                    }
+                    (_, Err(error)) => app.ui.status = error,
+                }
+            }
+        }
+        if let Some(receiver) = &self.work {
+            match receiver.try_recv() {
+                Ok(result) => {
+                    self.work = None;
+                    match result {
+                        Ok(Done::Zip(path)) => {
+                            self.prepared = Some(path);
+                            app.ui.status = "Bridge ZIP ready. File → Save ZIP to Files… chooses the destination.".into();
+                            if let Some(path) = &self.prepared {
+                                match self.native.export_copy(path) {
+                                    Ok(id) => self.pending = Some(Pending::Save(id)),
+                                    Err(e) => app.ui.status = e,
+                                }
+                            }
+                        }
+                        Ok(Done::Fonts(report)) => {
+                            if let Err(e) = app.session.execute("edit.purge", json!({"what":"memoryAndDisk"})) {
+                                log::warn!("Font cache refresh: {e}");
+                            }
+                            app.frames.clear();
+                            app.session.revision = app.session.revision.saturating_add(1);
+                            app.ui.status = report;
+                        }
+                        Err(error) => app.ui.status = error,
+                    }
+                }
+                Err(mpsc::TryRecvError::Disconnected) => {
+                    self.work = None;
+                    app.ui.status = "Bridge worker stopped before completing".into();
+                }
+                Err(mpsc::TryRecvError::Empty) => {}
+            }
+        }
+        let idle = !self.is_open();
+        *self.state.borrow_mut() = BridgeState {
+            import_enabled: idle,
+            export_enabled: idle && !app.session.project.items.is_empty(),
+            save_enabled: idle && self.prepared.is_some(),
+            fonts_enabled: idle,
+            status: String::new(),
+        };
+        if self.is_open() {
+            ctx.request_repaint_after(std::time::Duration::from_millis(50));
+        }
+    }
+}
+
+fn export(text: String, output: &Path, native: &NativeDocuments) -> Result<PathBuf, String> {
+    let mut doc: Value = serde_json::from_str(&text).map_err(|e| e.to_string())?;
+    let items = doc["items"].as_object_mut().ok_or("Project items are missing")?;
+    let mut entries = Vec::new();
+    let mut copies = Vec::new();
+    for (id, item) in items {
+        if item["kind"]["type"].as_str() != Some("Footage") {
+            continue;
+        }
+        let source = item["kind"]["path"].as_str().ok_or("Footage has no source path")?.to_string();
+        let original = PathBuf::from(&source);
+        if !original.is_absolute() {
+            return Err(format!("Re-import missing media before Bridge export: {source}"));
+        }
+        let copy = native.copy_read(&original)?;
+        let path = copy.as_ref().map(|c| c.path.clone()).unwrap_or(original.clone());
+        let ext = original.extension().and_then(|x| x.to_str()).filter(|s| s.len() <= 10 && s.bytes().all(|b| b.is_ascii_alphanumeric())).unwrap_or("bin");
+        let id: String = id.chars().filter(|c| c.is_ascii_alphanumeric()).take(80).collect();
+        let target = format!("assets/media_{id}.{ext}");
+        item["kind"]["path"] = json!(target);
+        item["kind"]["missing"] = json!(false);
+        entries.push((target, path));
+        if let Some(copy) = copy {
+            copies.push(copy);
+        }
+    }
+    let project = output.with_extension("ecproj");
+    let data = serde_json::to_vec(&doc).map_err(|e| e.to_string())?;
+    if data.len() > 32 << 20 {
+        return Err("Project JSON exceeds 32 MiB".into());
+    }
+    std::fs::write(&project, data).map_err(|e| e.to_string())?;
+    entries.insert(0, ("EffectCraft.ecproj".into(), project.clone()));
+    let result = crate::store_zip::write(output, &entries);
+    let _ = std::fs::remove_file(project);
+    drop(copies);
+    result.map(|_| output.to_path_buf())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn restored_file_commands_are_visible_in_the_native_menu() {
+        use egui::{Event, Modifiers, PointerButton, pos2, vec2};
+        use egui_kittest::Harness;
+        let mut session = effectcraft_host::session();
+        session.execute("comp.new", json!({"name":"Native input", "width":320, "height":180, "frameRate":30, "duration":10})).unwrap();
+        let layer = session.execute("layer.newSolid", json!({"name":"Hover to trim", "color":"#406080"})).unwrap()["layer"].as_u64().unwrap();
+        session.execute("layer.timing", json!({"layers":[layer],"in":2.0,"out":6.0})).unwrap();
+        let mut app = EffectcraftApp::new(session);
+        app.ui.start_screen = false;
+        let mut host = None;
+        let mut h = Harness::builder().with_size(vec2(1600.0, 1000.0)).build_eframe(|cc| {
+            host = Some(Bridge::install(&mut app, &cc.egui_ctx, NativeDocuments::new()));
+            app
+        });
+        h.run_steps(4);
+        // 0.11.1's new frontend command must coexist with our native File hooks.
+        let ctx = h.ctx.clone();
+        let copied = effectcraft_ui_egui::menus::invoke(h.state_mut(), &ctx, "mediaBrowser.copySourcePath", json!({"path":"/Synthetic/clip.mp4"})).unwrap();
+        assert_eq!(copied["path"], "/Synthetic/clip.mp4");
+        assert!(ctx.output(|o| o.commands.iter().any(|c| matches!(c, egui::OutputCommand::CopyText(t) if t == "/Synthetic/clip.mp4"))));
+        let bar = h.state().auto.find(&format!("timeline.layer.{layer}.bar")).unwrap().rect;
+        let center = pos2(bar[0] + bar[2] / 2.0, bar[1] + bar[3] / 2.0);
+        h.event(Event::PointerMoved(center));
+        h.run_steps(3);
+        let screenshot = |h: &mut Harness<'_, EffectcraftApp>, name: &str| {
+            if let Some(root) = std::env::var_os("EC_IPAD_SNAPSHOTS") {
+                let root = PathBuf::from(root);
+                std::fs::create_dir_all(&root).unwrap();
+                h.render().unwrap().save(root.join(name)).unwrap();
+            }
+        };
+        screenshot(&mut h, "native-hover-trim.png");
+        for pressed in [true, false] {
+            h.event(Event::PointerButton { pos: center, button: PointerButton::Secondary, pressed, modifiers: Modifiers::NONE });
+        }
+        h.run_steps(3);
+        assert!(egui::Popup::is_any_open(&h.ctx));
+        screenshot(&mut h, "native-context-menu.png");
+        h.event(Event::Key { key: egui::Key::Escape, physical_key: None, pressed: true, repeat: false, modifiers: Modifiers::NONE });
+        h.run_steps(3);
+        let menu = h.state().auto.find("menu.File").unwrap().rect;
+        let pos = pos2(menu[0] + menu[2] / 2.0, menu[1] + menu[3] / 2.0);
+        h.event(Event::PointerMoved(pos));
+        for pressed in [true, false] {
+            h.event(Event::PointerButton { pos, button: PointerButton::Primary, pressed, modifiers: Modifiers::NONE });
+            h.step();
+        }
+        h.run_steps(3);
+        for id in ["bridge.importAEZip", "bridge.exportProjectZip", "bridge.saveZipToFiles", "bridge.importFonts"] {
+            assert!(h.state().auto.find(&format!("menu.command.{id}")).is_some(), "missing native File command {id}");
+        }
+        screenshot(&mut h, "native-file-menu.png");
+        drop(host);
+    }
+    #[test]
+    fn bridge_export_is_portable_and_does_not_change_the_open_project() {
+        let root = std::env::temp_dir().join(format!("ec-native-bridge-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let media = root.join("Клип с пробелом.png");
+        std::fs::write(&media, [1, 2, 3, 4, 5]).unwrap();
+        let document = json!({"schema":2,"items":{"7":{"name":"Clip","kind":{"type":"Footage","path":media,"missing":true}}}});
+        let original = document.to_string();
+        let output = root.join("ForAE.zip");
+        export(original.clone(), &output, &NativeDocuments::new()).unwrap();
+        assert_eq!(document.to_string(), original);
+        let imported = crate::project_zip::import(&output, &root, &std::sync::atomic::AtomicBool::new(false)).unwrap();
+        let restored: Value = serde_json::from_slice(&std::fs::read(&imported).unwrap()).unwrap();
+        assert_eq!(restored["items"]["7"]["kind"]["path"], "assets/media_7.png");
+        assert_eq!(restored["items"]["7"]["kind"]["missing"], false);
+        assert_eq!(std::fs::read(imported.parent().unwrap().join("assets/media_7.png")).unwrap(), [1, 2, 3, 4, 5]);
+        let mut app = EffectcraftApp::new(effectcraft_host::session());
+        let bridge = Bridge::install(&mut app, &egui::Context::default(), NativeDocuments::new());
+        let items = menus::menu_items(&app);
+        for id in ["bridge.importAEZip", "bridge.exportProjectZip", "bridge.saveZipToFiles", "bridge.importFonts"] {
+            assert!(items.iter().any(|i| i.id == id));
+        }
+        assert!(!bridge.state.borrow().save_enabled);
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
