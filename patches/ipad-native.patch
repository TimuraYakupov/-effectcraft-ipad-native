@@ -0,0 +1,76 @@
+//! Stable settings and recovery storage, including LiveContainer upgrades.
+use std::{path::Path, sync::Arc};
+use effectcraft_engine::{Session, config::DirConfig};
+
+pub fn configure(session: &mut Session, documents: &Path) {
+    let settings = documents.join("Settings");
+    let first_launch = !settings.join(effectcraft_engine::prefs::PREFS_FILE).is_file();
+    session.config = Some(Arc::new(DirConfig::new(settings)));
+    session.load_settings();
+    if first_launch {
+        session.prefs.memory.layer_cache_mb = 64;
+        session.prefs.memory.media_cache_mb = 64;
+        session.prefs.memory.preview_cache_mb = 2048;
+        session.prefs.previews.cache_frames_when_idle = true;
+        session.prefs.disk.disk_cache_enabled = true;
+        session.prefs.disk.disk_cache_max_gb = 1;
+        session.prefs.auto_save.enabled = true;
+        session.prefs.auto_save.interval_minutes = 1;
+        session.prefs.export.default_output_folder = documents.join("Renders").to_string_lossy().into_owned();
+    }
+    // Apply the requested larger default once for existing build-12 installs, then
+    // respect subsequent choices made in Settings or Diagnostics.
+    let migrated = session.config.as_ref().and_then(|c| c.read("ipad-preview-cache-v13")).as_deref() == Some("2048");
+    if !migrated { session.prefs.memory.preview_cache_mb = 2048; }
+    // OS cache paths may change across installs; preferences belong in Documents.
+    session.prefs.disk.disk_cache_folder = effectcraft_engine::render::disk_cache::default_folder().to_string_lossy().into_owned();
+    session.autosave_folder_override = Some(documents.join("Recovery"));
+    session.autosave.background = true;
+    session.check_footage_on_open = true;
+    session.prefs_changed();
+    session.save_prefs();
+    if let Some(config) = &session.config {
+        if let Err(error) = config.write("ipad-preview-cache-v13", "2048") { log::warn!("Cache preference migration: {error}"); }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn upgrade_applies_two_gib_once_and_keeps_later_choice() {
+        let root = std::env::temp_dir().join(format!("ec-cache-upgrade-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let mut old = Session::default();
+        old.config = Some(Arc::new(DirConfig::new(root.join("Settings"))));
+        old.prefs.memory.preview_cache_mb = 1024;
+        old.save_prefs();
+        configure(&mut old, &root);
+        assert_eq!(old.prefs.memory.preview_cache_mb, 2048);
+        old.prefs.memory.preview_cache_mb = 512;
+        old.save_prefs();
+        let mut next = Session::default();
+        configure(&mut next, &root);
+        assert_eq!(next.prefs.memory.preview_cache_mb, 512);
+        let _ = std::fs::remove_dir_all(root);
+    }
+    #[test]
+    fn relaunch_keeps_cache_and_autosave_choices() {
+        let root = std::env::temp_dir().join(format!("ec-settings-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        let mut first = Session::default();
+        configure(&mut first, &root);
+        assert_eq!(first.prefs.memory.preview_cache_mb, 2048);
+        first.prefs.memory.preview_cache_mb = 256;
+        first.prefs.disk.disk_cache_enabled = false;
+        first.prefs.auto_save.interval_minutes = 3;
+        first.save_prefs();
+        let mut next = Session::default();
+        configure(&mut next, &root);
+        assert_eq!(next.prefs.memory.preview_cache_mb, 256);
+        assert!(!next.prefs.disk.disk_cache_enabled);
+        assert_eq!(next.prefs.auto_save.interval_minutes, 3);
+        assert_eq!(next.autosave_folder_override, Some(root.join("Recovery")));
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
