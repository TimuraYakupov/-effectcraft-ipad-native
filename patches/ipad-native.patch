@@ -0,0 +1,23 @@
+//! Capture edits when focus is lost, including the UIKit suspension notification.
+#[derive(Default)]
+pub struct Lifecycle {
+    inactive: bool,
+}
+impl Lifecycle {
+    pub fn input(&mut self, app: &mut effectcraft_ui_egui::EffectcraftApp, focused: bool) {
+        let marker = crate::native_documents::NativeDocuments::lifecycle_path();
+        let inactive = !focused || std::fs::read_to_string(marker).is_ok_and(|v| v == format!("{}:inactive", std::process::id()));
+        if inactive && !self.inactive {
+            app.stop();
+            app.session.save_prefs();
+            if app.session.is_dirty() {
+                if let Err(error) = app.session.autosave_now().and_then(|_| app.session.autosave_wait()) {
+                    log::error!("Background recovery save: {error}");
+                    app.ui.status = format!("Recovery save failed: {error}");
+                }
+            }
+            app.session.update_sentinel();
+        }
+        self.inactive = inactive;
+    }
+}
