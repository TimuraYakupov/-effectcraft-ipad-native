index 00000000..03464fe5
--- /dev/null
+++ b/apps/effectcraft-ios/src/project_zip.rs
@@ -0,0 +1,211 @@
+//! Streaming reader for stored Bridge ZIPs (PKWARE APPNOTE 6.3 local headers).
+//! No archive-sized buffer, no external paths, no overwriting existing projects.
+use std::collections::HashSet;
+use std::io::{Read, Write};
+use std::path::{Component, Path, PathBuf};
+use std::sync::atomic::{AtomicBool, AtomicU64, Ordering};
+
+static NEXT: AtomicU64 = AtomicU64::new(0);
+const MAX_TOTAL: u64 = 512 << 20;
+
+pub fn relative_name(name: &str) -> Result<PathBuf, String> {
+    let name = name.replace('\\', "/");
+    let path = Path::new(&name);
+    if name.is_empty()
+        || name.len() > 1024
+        || name.contains(':')
+        || name.contains('\0')
+        || name.split('/').any(|s| s == ".." || s == ".")
+        || path.components().any(|c| !matches!(c, Component::Normal(_)))
+    {
+        return Err("ZIP contains an invalid or external file path".into());
+    }
+    Ok(path.into())
+}
+
+pub fn import(archive: &Path, documents: &Path, cancel: &AtomicBool) -> Result<PathBuf, String> {
+    let root = documents.join("Projects");
+    std::fs::create_dir_all(&root).map_err(|e| e.to_string())?;
+    let root = root.canonicalize().map_err(|e| e.to_string())?;
+    let docs = documents.canonicalize().map_err(|e| e.to_string())?;
+    if !root.starts_with(&docs) {
+        return Err("Projects folder points outside Documents".into());
+    }
+    let stamp = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).map_err(|e| e.to_string())?.as_nanos();
+    let id = NEXT.fetch_add(1, Ordering::Relaxed);
+    let staging = root.join(format!(".import-{stamp}-{id}"));
+    std::fs::create_dir(&staging).map_err(|e| e.to_string())?;
+    let result = extract(archive, &staging, cancel).and_then(|name| {
+        if cancel.load(Ordering::Relaxed) {
+            return Err("Import cancelled".into());
+        }
+        let final_dir = root.join(format!("Imported-{stamp}-{id}"));
+        std::fs::rename(&staging, &final_dir).map_err(|e| e.to_string())?;
+        Ok(final_dir.join(name))
+    });
+    if result.is_err() {
+        let _ = std::fs::remove_dir_all(&staging);
+    }
+    result
+}
+
+fn number16(b: &[u8], at: usize) -> Result<u16, String> {
+    let bytes = b.get(at..at.saturating_add(2)).ok_or("Truncated ZIP header")?;
+    Ok(u16::from_le_bytes(bytes.try_into().map_err(|_| "Invalid ZIP header")?))
+}
+fn number32(b: &[u8], at: usize) -> Result<u32, String> {
+    let bytes = b.get(at..at.saturating_add(4)).ok_or("Truncated ZIP header")?;
+    Ok(u32::from_le_bytes(bytes.try_into().map_err(|_| "Invalid ZIP header")?))
+}
+
+fn extract(archive: &Path, dest: &Path, cancel: &AtomicBool) -> Result<PathBuf, String> {
+    let mut file = std::fs::File::open(archive).map_err(|e| e.to_string())?;
+    if file.metadata().map_err(|e| e.to_string())?.len() > (1 << 30) {
+        return Err("ZIP is larger than 1 GiB".into());
+    }
+    let mut names = HashSet::new();
+    let mut project = None;
+    let mut total = 0_u64;
+    let mut table = [0_u32; 256];
+    for (i, slot) in table.iter_mut().enumerate() {
+        let mut c = i as u32;
+        for _ in 0..8 {
+            c = if c & 1 == 1 { (c >> 1) ^ 0xedb88320 } else { c >> 1 };
+        }
+        *slot = c;
+    }
+    loop {
+        if cancel.load(Ordering::Relaxed) {
+            return Err("Import cancelled".into());
+        }
+        let mut signature = [0; 4];
+        file.read_exact(&mut signature).map_err(|e| format!("Truncated ZIP: {e}"))?;
+        let sig = u32::from_le_bytes(signature);
+        if sig == 0x02014b50 || sig == 0x06054b50 {
+            break;
+        }
+        if sig != 0x04034b50 || names.len() >= 4096 {
+            return Err("Invalid ZIP or too many entries".into());
+        }
+        let mut h = [0; 26];
+        file.read_exact(&mut h).map_err(|e| e.to_string())?;
+        if number16(&h, 2)? & 9 != 0 || number16(&h, 4)? != 0 {
+            return Err("This ZIP is compressed or encrypted. Unzip it in Files, then open its .ecproj.".into());
+        }
+        let crc = number32(&h, 10)?;
+        let size = number32(&h, 14)? as u64;
+        if size != number32(&h, 18)? as u64 {
+            return Err("Invalid stored ZIP size".into());
+        }
+        total = total.checked_add(size).filter(|n| *n <= MAX_TOTAL).ok_or("Unpacked ZIP exceeds 512 MiB")?;
+        let name_len = number16(&h, 22)? as usize;
+        if name_len == 0 || name_len > 1024 {
+            return Err("Invalid ZIP filename".into());
+        }
+        let mut name = vec![0; name_len];
+        file.read_exact(&mut name).map_err(|e| e.to_string())?;
+        let name = String::from_utf8(name).map_err(|_| "ZIP filenames must use UTF-8")?;
+        let relative = relative_name(&name)?;
+        if !names.insert(relative.clone()) {
+            return Err("ZIP contains duplicate file paths".into());
+        }
+        let mut extra = vec![0; number16(&h, 24)? as usize];
+        file.read_exact(&mut extra).map_err(|e| e.to_string())?;
+        let target = dest.join(&relative);
+        if name.ends_with('/') {
+            if size != 0 {
+                return Err("Invalid ZIP folder entry".into());
+            }
+            std::fs::create_dir_all(&target).map_err(|e| e.to_string())?;
+            continue;
+        }
+        if relative.components().count() == 1 && relative.extension().is_some_and(|e| e.eq_ignore_ascii_case("ecproj")) {
+            if project.is_some() || size > 32 << 20 {
+                return Err("ZIP must contain exactly one root .ecproj, at most 32 MiB".into());
+            }
+            project = Some(relative.clone());
+        }
+        if let Some(parent) = target.parent() {
+            std::fs::create_dir_all(parent).map_err(|e| e.to_string())?;
+        }
+        let mut out = std::fs::File::options().write(true).create_new(true).open(&target).map_err(|e| e.to_string())?;
+        let mut left = size;
+        let mut check = u32::MAX;
+        let mut buffer = [0; 65536];
+        while left > 0 {
+            if cancel.load(Ordering::Relaxed) {
+                return Err("Import cancelled".into());
+            }
+            let count = left.min(buffer.len() as u64) as usize;
+            let chunk = buffer.get_mut(..count).ok_or("Invalid ZIP read size")?;
+            file.read_exact(chunk).map_err(|e| e.to_string())?;
+            for byte in chunk.iter() {
+                let index = ((check ^ u32::from(*byte)) & 255) as usize;
+                check = (check >> 8) ^ table.get(index).copied().ok_or("Invalid CRC index")?;
+            }
+            out.write_all(chunk).map_err(|e| e.to_string())?;
+            left -= count as u64;
+        }
+        if !check != crc {
+            return Err(format!("ZIP checksum failed: {name}"));
+        }
+    }
+    project.ok_or_else(|| "ZIP must contain exactly one .ecproj at its root".into())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn fixture(name: &str, entries: &str, corrupt: bool) -> (PathBuf, PathBuf) {
+        let root = std::env::temp_dir().join(format!("ec-native-zip-{name}-{}", std::process::id()));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).unwrap();
+        let archive = root.join("input.zip");
+        let script = "import zipfile,sys,json\np=sys.argv[1]\nwith zipfile.ZipFile(p,'w',zipfile.ZIP_STORED) as z:\n for n,d in json.loads(sys.argv[2]):z.writestr(n,d)\nif sys.argv[3]=='true':\n b=bytearray(open(p,'rb').read());b[30+len('Project.ecproj')+1]^=1;open(p,'wb').write(b)\n";
+        assert!(
+            std::process::Command::new("python3")
+                .args(["-c", script, archive.to_str().unwrap(), entries, if corrupt { "true" } else { "false" }])
+                .status()
+                .unwrap()
+                .success()
+        );
+        (root, archive)
+    }
+
+    #[test]
+    fn extracts_project_and_media_without_overwriting_previous_imports() {
+        let (root, zip) = fixture("roundtrip", r#"[["Project.ecproj","{\"schema\":1}"],["media/test.txt","pixels"]]"#, false);
+        let project = import(&zip, &root, &AtomicBool::new(false)).unwrap();
+        assert_eq!(std::fs::read_to_string(&project).unwrap(), "{\"schema\":1}");
+        assert_eq!(std::fs::read_to_string(project.parent().unwrap().join("media/test.txt")).unwrap(), "pixels");
+        let second = import(&zip, &root, &AtomicBool::new(false)).unwrap();
+        assert_ne!(project, second);
+        assert!(project.exists());
+        let count = std::fs::read_dir(root.join("Projects")).unwrap().count();
+        assert!(import(&zip, &root, &AtomicBool::new(true)).is_err());
+        assert_eq!(std::fs::read_dir(root.join("Projects")).unwrap().count(), count);
+        let _ = std::fs::remove_dir_all(root);
+    }
+
+    #[test]
+    fn rejects_traversal_bad_crc_and_multiple_projects_without_partial_imports() {
+        for (name, entries, corrupt) in [
+            ("traversal", r#"[["../escape.ecproj","{}"]]"#, false),
+            ("checksum", r#"[["Project.ecproj","{\"schema\":1}"]]"#, true),
+            ("multiple", r#"[["A.ecproj","{}"],["B.ecproj","{}"]]"#, false),
+        ] {
+            let (root, zip) = fixture(name, entries, corrupt);
+            assert!(import(&zip, &root, &AtomicBool::new(false)).is_err(), "{name}");
+            assert_eq!(std::fs::read_dir(root.join("Projects")).unwrap().count(), 0);
+            let _ = std::fs::remove_dir_all(root);
+        }
+    }
+    #[test]
+    fn rejects_external_and_traversal_paths() {
+        for bad in ["../x", "/x", "C:/x", "media/../../x", "media\\..\\x", "./x", ""] {
+            assert!(relative_name(bad).is_err(), "{bad}");
+        }
+        assert_eq!(relative_name("media/a.png").unwrap(), PathBuf::from("media/a.png"));
+    }
+}
diff --git a/apps/effectcraft-ios/src/render_files.rs b/apps/effectcraft-ios/src/render_files.rs
new file mode 100644
index 00000000..e50c72a1
--- /dev/null
+++ b/apps/effectcraft-ios/src/render_files.rs
@@ -0,0 +1,116 @@
+//! Deliver finished files without retaining video or sequence pixels in RAM.
+use crate::native_documents::NativeDocuments;
+use effectcraft_ui_egui::EffectcraftApp;
+use eframe::egui;
+use std::{path::PathBuf, sync::mpsc::{self, Receiver}};
+
+pub struct RenderFiles {
+    requests: Receiver<Vec<String>>,
+    work: Option<Receiver<Result<PathBuf, String>>>,
+    pending: Option<String>,
+    temporary: Option<PathBuf>,
+    native: NativeDocuments,
+}
+impl RenderFiles {
+    pub fn install(app: &mut EffectcraftApp, ctx: &egui::Context, native: NativeDocuments) -> Self {
+        let (send, requests) = mpsc::sync_channel(1);
+        let wake = ctx.clone();
+        app.hooks.save_rendered = Some(Box::new(move |paths| {
+            if paths.is_empty() || paths.len() > 4096 { return Err("Invalid render output count".into()); }
+            send.try_send(paths).map_err(|_| "A render export is already waiting".to_string())?;
+            wake.request_repaint();
+            Ok(())
+        }));
+        Self { requests, work: None, pending: None, temporary: None, native }
+    }
+    pub fn is_open(&self) -> bool { self.pending.is_some() || self.work.is_some() }
+    pub fn show(&mut self, app: &mut EffectcraftApp, ctx: &egui::Context) {
+        if !self.is_open() {
+            if let Ok(paths) = self.requests.try_recv() {
+                app.stop();
+                if paths.len() == 1 {
+                    self.start(app, &PathBuf::from(&paths[0]));
+                } else {
+                    match self.native.staging("Rendered-Sequence.zip", "zip") {
+                        Err(error) => app.ui.status = error,
+                        Ok(output) => {
+                            let (send, receive) = mpsc::sync_channel(1);
+                            let wake = ctx.clone();
+                            let result = std::thread::Builder::new().name("ec-render-delivery".into()).spawn(move || {
+                                let result = package_sequence(&paths, &output).map(|_| output);
+                                let _ = send.send(result);
+                                wake.request_repaint();
+                            });
+                            match result {
+                                Ok(_) => { self.work = Some(receive); app.ui.status = "Packaging rendered sequence…".into(); }
+                                Err(error) => app.ui.status = error.to_string(),
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        if let Some(work) = &self.work {
+            match work.try_recv() {
+                Ok(result) => {
+                    self.work = None;
+                    match result {
+                        Ok(path) => { self.temporary = Some(path.clone()); self.start(app, &path); }
+                        Err(error) => app.ui.status = error,
+                    }
+                }
+                Err(mpsc::TryRecvError::Disconnected) => { self.work = None; app.ui.status = "Render delivery worker stopped".into(); }
+                Err(mpsc::TryRecvError::Empty) => {}
+            }
+        }
+        if let Some(id) = &self.pending {
+            if let Some(result) = self.native.poll(id) {
+                self.pending = None;
+                app.ui.status = match result {
+                    Ok(value) if value["cancelled"].as_bool() == Some(true) => "Save cancelled; rendered output is kept in Renders".into(),
+                    Ok(_) => "Rendered output saved to Files".into(),
+                    Err(error) => error,
+                };
+                if let Some(path) = self.temporary.take() { let _ = std::fs::remove_file(path); }
+            }
+        }
+        if self.is_open() { ctx.request_repaint_after(std::time::Duration::from_millis(100)); }
+    }
+    fn start(&mut self, app: &mut EffectcraftApp, path: &std::path::Path) {
+        match self.native.export_copy(path) {
+            Ok(id) => self.pending = Some(id),
+            Err(error) => app.ui.status = error,
+        }
+    }
+}
+fn package_sequence(paths: &[String], output: &std::path::Path) -> Result<(), String> {
+    let entries = paths.iter().map(|path| {
+        let path = PathBuf::from(path);
+        let name = path.file_name().and_then(|s| s.to_str()).ok_or("Invalid sequence filename")?.to_owned();
+        if !path.is_file() { return Err(format!("Rendered frame is missing: {name}")); }
+        Ok((name, path))
+    }).collect::<Result<Vec<_>, String>>()?;
+    crate::store_zip::write(output, &entries)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn sequence_export_rejects_missing_frames_and_preserves_originals() {
+        let root = std::env::temp_dir().join(format!("ec-render-package-{}", std::process::id()));
+        std::fs::create_dir_all(&root).unwrap();
+        let a = root.join("frame0001.png");
+        let b = root.join("frame0002.png");
+        std::fs::write(&a, b"original frame one").unwrap();
+        let paths = vec![a.to_string_lossy().into_owned(), b.to_string_lossy().into_owned()];
+        assert!(package_sequence(&paths, &root.join("missing.zip")).is_err());
+        assert!(!root.join("missing.zip").exists());
+        std::fs::write(&b, b"original frame two").unwrap();
+        package_sequence(&paths, &root.join("complete.zip")).unwrap();
+        assert_eq!(std::fs::read(&a).unwrap(), b"original frame one");
+        assert_eq!(std::fs::read(&b).unwrap(), b"original frame two");
+        assert!(std::fs::metadata(root.join("complete.zip")).unwrap().len() > 32);
+        let _ = std::fs::remove_dir_all(root);
+    }
+}
