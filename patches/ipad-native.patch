index 00000000..7d39b717
--- /dev/null
+++ b/apps/effectcraft-web/src/fonts.rs
@@ -0,0 +1,80 @@
+//! Persistent user fonts, shared with the rendering workers.
+use std::cell::RefCell;
+use std::collections::{BTreeMap, hash_map::DefaultHasher};
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+use serde_json::{Value, json};
+
+pub const MAX_FONT: usize = 32 * 1024 * 1024;
+const MAX_TOTAL: usize = 128 * 1024 * 1024;
+const MAX_FILES: usize = 128;
+const PREFIX: &str = "/_ECFont_";
+struct Registered { data: Arc<[u8]>, faces: Value, order: usize }
+thread_local! {
+    static REGISTERED: RefCell<BTreeMap<String, Registered>> = const { RefCell::new(BTreeMap::new()) };
+}
+pub fn is_font_path(path: &str) -> bool { path.starts_with(PREFIX) && is_font_name(path) }
+pub fn is_font_name(name: &str) -> bool {
+    name.rsplit('.').next().is_some_and(|s| matches!(s.to_ascii_lowercase().as_str(), "ttf" | "otf" | "ttc" | "otc"))
+}
+pub fn paths() -> Vec<String> {
+    REGISTERED.with(|r| {
+        let registered = r.borrow();
+        let mut entries: Vec<_> = registered.iter().collect();
+        entries.sort_by_key(|(_, f)| f.order);
+        entries.into_iter().map(|(p, _)| p.clone()).collect()
+    })
+}
+fn report(path: &str, font: &Registered, duplicate: bool) -> Value {
+    json!({"path":path, "faces":font.faces, "bytes":font.data.len(), "duplicate":duplicate})
+}
+pub fn list() -> Value {
+    REGISTERED.with(|r| Value::Array(r.borrow().iter().map(|(p,f)| report(p,f,false)).collect()))
+}
+pub fn register(path: &str, data: Arc<[u8]>) -> Result<Value, String> {
+    if !is_font_path(path) || data.len() > MAX_FONT { return Err("Invalid font path or font exceeds 32 MB".into()); }
+    REGISTERED.with(|r| {
+        let mut registered = r.borrow_mut();
+        if let Some((p,f)) = registered.iter().find(|(_,f)| f.data.as_ref() == data.as_ref()) {
+            return Ok(report(p,f,true));
+        }
+        if registered.contains_key(path) { return Err("Font storage name collision".into()); }
+        let total: usize = registered.values().map(|f| f.data.len()).sum();
+        if registered.len() >= MAX_FILES || total.saturating_add(data.len()) > MAX_TOTAL {
+            return Err("User font library exceeds 128 files / 128 MB".into());
+        }
+        let ids = effectcraft_text::fonts::add_font_data_checked(data.to_vec())?;
+        let faces = Value::Array(ids.into_iter().map(|id| {
+            let face = effectcraft_text::fonts::face(id);
+            json!({"family":face.info.family, "style":face.info.style, "postscript":face.info.postscript})
+        }).collect());
+        let font = Registered { data, faces, order: registered.len() };
+        let result = report(path,&font,false);
+        registered.insert(path.to_string(),font);
+        Ok(result)
+    })
+}
+pub fn import(name: &str, data: Arc<[u8]>) -> Result<Value, String> {
+    if !is_font_name(name) || data.len() > MAX_FONT { return Err("Choose a TTF, OTF, TTC or OTC font up to 32 MB".into()); }
+    let mut hasher = DefaultHasher::new(); data.hash(&mut hasher);
+    let extension = name.rsplit('.').next().unwrap_or("ttf").to_ascii_lowercase();
+    let path = format!("{PREFIX}{:016x}.{extension}",hasher.finish());
+    let result = register(&path,data.clone())?;
+    if result["duplicate"].as_bool() != Some(true) { crate::files::put(&path,data); }
+    Ok(result)
+}
+pub fn restore() -> Vec<String> {
+    let mut errors = Vec::new();
+    let mut stored = crate::files::STORE.files();
+    stored.sort_by(|a,b| a.2.total_cmp(&b.2).then_with(|| a.0.cmp(&b.0)));
+    for (path,_,_,_) in stored {
+        if is_font_path(&path) && let Some(data) = crate::files::get(&path)
+            && let Err(error) = register(&path,data) { errors.push(format!("{path}: {error}")); }
+    }
+    errors
+}
+pub fn refresh(app: &mut effectcraft_ui_egui::EffectcraftApp) {
+    if let Err(error) = app.session.execute("edit.purge",json!({"what":"memoryAndDisk"})) { log::warn!("Font cache invalidation: {error}"); }
+    app.frames.clear();
+    app.session.revision = app.session.revision.saturating_add(1);
+}
